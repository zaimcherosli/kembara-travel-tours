  function getStoredStaff() {
    const raw = localStorage.getItem('kembara_staff_list');
    if (raw) {
      try { return JSON.parse(raw); } catch (e) { return DEFAULT_STAFF_ITEMS; }
    }
    return DEFAULT_STAFF_ITEMS;
  }

  function saveStoredStaff(items) {
    localStorage.setItem('kembara_staff_list', JSON.stringify(items));
  }

  function getStoredLeaves() {
    const raw = localStorage.getItem('kembara_leave_list');
    if (raw) {
      try { return JSON.parse(raw); } catch (e) { return DEFAULT_LEAVE_ITEMS; }
    }
    return DEFAULT_LEAVE_ITEMS;
  }

  function saveStoredLeaves(items) {
    localStorage.setItem('kembara_leave_list', JSON.stringify(items));
  }

  function getStoredLedger() {
    const raw = localStorage.getItem('kembara_ledger_data');
    if (raw) {
      try { return JSON.parse(raw); } catch (e) { return DEFAULT_LEDGER_ITEMS; }
    }
    return DEFAULT_LEDGER_ITEMS;
  }

  function saveStoredLedger(items) {
    localStorage.setItem('kembara_ledger_data', JSON.stringify(items));
  }

  function getStoredSlots() {
    const raw = localStorage.getItem('kembara_package_slots');
    if (raw) {
      try { return JSON.parse(raw); } catch (e) { return {}; }
    }
    return {};
  }

  function saveStoredSlots(map) {
    localStorage.setItem('kembara_package_slots', JSON.stringify(map));
  }

  // -------------------------------------------------------------
  // ROLE-BASED ACCESS CONTROL (RBAC) ENGINE
  // -------------------------------------------------------------
  let currentRoleKey = 'admin';
  let currentUserName = 'Zaim Rosli';
  let currentUserRoleDisplay = 'Admin Utama';

  function applyRolePermissions(roleKey, userName, roleDisplay) {
    currentRoleKey = roleKey || 'admin';
    if (userName) currentUserName = userName;
    if (roleDisplay) currentUserRoleDisplay = roleDisplay;

    const nameEl = document.getElementById('display-staff-name');
    const roleEl = document.getElementById('display-staff-role');
    const badgeEl = document.getElementById('header-role-badge');

    if (nameEl) nameEl.textContent = currentUserName.toUpperCase();
    if (roleEl) roleEl.textContent = currentUserRoleDisplay;
    if (badgeEl) {
      badgeEl.textContent = currentRoleKey.toUpperCase();
      if (currentRoleKey === 'admin') badgeEl.className = 'px-1.5 py-0.5 rounded text-[10px] font-extrabold bg-teal-100 text-teal-900 border border-teal-300';
      else if (currentRoleKey === 'sales') badgeEl.className = 'px-1.5 py-0.5 rounded text-[10px] font-extrabold bg-sky-100 text-sky-900 border border-sky-300';
      else if (currentRoleKey === 'finance') badgeEl.className = 'px-1.5 py-0.5 rounded text-[10px] font-extrabold bg-emerald-100 text-emerald-900 border border-emerald-300';
      else if (currentRoleKey === 'hr') badgeEl.className = 'px-1.5 py-0.5 rounded text-[10px] font-extrabold bg-amber-100 text-amber-900 border border-amber-300';
    }

    // Filter Tab Buttons based on role
    const tabButtons = document.querySelectorAll('.tab-btn');
    tabButtons.forEach(btn => {
      const allowedRoles = (btn.getAttribute('data-roles') || 'admin').split(',');
      if (currentRoleKey === 'admin' || allowedRoles.includes(currentRoleKey)) {
        btn.classList.remove('hidden');
      } else {
        btn.classList.add('hidden');
      }
    });

    // Auto-switch to appropriate default tab
    if (currentRoleKey === 'sales') switchTab('bookings');
    else if (currentRoleKey === 'finance') switchTab('accounts');
    else if (currentRoleKey === 'hr') switchTab('hr');
    else switchTab('overview');

    // Re-render UI components
    renderStaffCards();
    renderLeavesTable();
    renderLedgerAndRecon();
    populateLeaveStaffDropdown();
    refreshCmsSlotsDisplay();
  }

  // Load Session on init
  const sessionData = localStorage.getItem('kembara_staff_session');
  if (sessionData) {
    try {
      const parsed = JSON.parse(sessionData);
      applyRolePermissions(parsed.roleKey || 'admin', parsed.name || 'Zaim Rosli', parsed.role || 'Admin Utama');
    } catch (e) {
      applyRolePermissions('admin');
    }
  } else {
    applyRolePermissions('admin');
  }

  // Tab switching function
  function switchTab(tabId) {
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabPanes = document.querySelectorAll('.tab-pane');

    tabButtons.forEach(btn => {
      if (btn.getAttribute('data-tab') === tabId) {
        btn.classList.add('bg-teal-700', 'text-white', 'shadow-sm');
        btn.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');
      } else {
        btn.classList.remove('bg-teal-700', 'text-white', 'shadow-sm');
        btn.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
      }
    });

    tabPanes.forEach(pane => {
      if (pane.id === `tab-${tabId}`) {
        pane.classList.remove('hidden');
      } else {
        pane.classList.add('hidden');
      }
    });
  }

  // Bind tab buttons
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab');
      if (tab) switchTab(tab);
    });
  });

  // Cross-tab button triggers
  document.querySelectorAll('.switch-to-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-target');
      if (target) switchTab(target);
    });
  });

  // Logout button binding
  const logoutBtn = document.getElementById('logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      localStorage.removeItem('kembara_staff_session');
      window.location.href = '/staf/login/';
    });
  }

  // -------------------------------------------------------------
  // HR & LEAVE APPROVAL SYSTEM
  // -------------------------------------------------------------
  function populateLeaveStaffDropdown() {
    const staffList = getStoredStaff();
    const selectEl = document.getElementById('modal-leave-staff');
    if (!selectEl) return;

    selectEl.innerHTML = staffList.map(stf => `
      <option value="${stf.id}" data-name="${stf.name}" data-role="${stf.role}" ${stf.name.toLowerCase().includes(currentUserName.toLowerCase().split(' ')[0]) ? 'selected' : ''}>
        ${stf.name} (${stf.role})
      </option>
    `).join('');
  }

  function renderStaffCards() {
    const staffList = getStoredStaff();
    const container = document.getElementById('staff-cards-container');
    const totalStaffEl = document.getElementById('hr-stat-total-staff');
    if (totalStaffEl) totalStaffEl.textContent = `${staffList.length} Orang`;

    if (!container) return;

    container.innerHTML = staffList.map(stf => `
      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-xs space-y-3.5 hover:bg-white hover:shadow-md transition-all">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-teal-800 font-mono">${stf.id}</span>
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold ${
            stf.status === 'Aktif' ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' :
            stf.status === 'Cuti' ? 'bg-amber-100 text-amber-800 border border-amber-200' :
            'bg-sky-100 text-sky-800 border border-sky-200'
          }">
            ${stf.status}
          </span>
        </div>
        <div>
          <h4 class="text-base font-extrabold text-slate-900">${stf.name}</h4>
          <div class="text-xs font-bold text-slate-600">${stf.role}</div>
          <div class="text-[11px] text-slate-500 mt-1">${stf.email} • ${stf.phone}</div>
        </div>
        <div class="pt-3 border-t border-slate-200 grid grid-cols-2 gap-2 text-xs">
          <div>
            <span class="text-[10px] text-slate-500 font-medium block">Tugasan Trip</span>
            <span class="font-bold text-slate-900">${stf.assignedTripsCount || 0} Trip Diketuai</span>
          </div>
          <div>
            <span class="text-[10px] text-slate-500 font-medium block">Deals Jualan</span>
            <span class="font-bold text-teal-700">${stf.totalSalesDeals || 0} Pelanggan</span>
          </div>
        </div>
      </div>
    `).join('');
  }

  function renderLeavesTable() {
    const leaves = getStoredLeaves();
    const tbody = document.getElementById('leave-table-tbody');
    const countEl = document.getElementById('leave-table-count');
    const hrPendingEl = document.getElementById('hr-stat-pending-leaves');
    const overviewLeavesEl = document.getElementById('overview-stat-leaves');
    const tabBadgeEl = document.getElementById('tab-leave-badge');

    const pendingCount = leaves.filter(l => l.status === 'Menunggu Kelulusan').length;

    if (countEl) countEl.textContent = `${leaves.length} Rekod Cuti`;
    if (hrPendingEl) hrPendingEl.textContent = `${pendingCount} Permohonan`;
    if (overviewLeavesEl) overviewLeavesEl.textContent = `${pendingCount} Permohonan`;

    if (tabBadgeEl) {
      if (pendingCount > 0) {
        tabBadgeEl.textContent = `${pendingCount}`;
        tabBadgeEl.classList.remove('hidden');
      } else {
        tabBadgeEl.classList.add('hidden');
      }
    }

    if (!tbody) return;

    const canApprove = currentRoleKey === 'admin' || currentRoleKey === 'hr';

    tbody.innerHTML = leaves.map(lv => `
      <tr class="hover:bg-slate-50 transition-colors">
        <td class="py-3 px-3 whitespace-nowrap">
          <div class="font-bold text-slate-900">${lv.appliedAt}</div>
          <span class="text-[10px] text-amber-700 font-mono font-bold">${lv.id}</span>
        </td>
        <td class="py-3 px-3 whitespace-nowrap">
          <div class="font-bold text-slate-900">${lv.staffName}</div>
          <div class="text-[10px] text-slate-500">${lv.staffRole}</div>
        </td>
        <td class="py-3 px-3 whitespace-nowrap">
          <span class="bg-slate-100 text-slate-800 font-bold px-2 py-0.5 rounded text-[10px] border border-slate-200">
            ${lv.leaveType}
          </span>
        </td>
        <td class="py-3 px-3 whitespace-nowrap">
          <div class="font-semibold text-slate-900">${lv.startDate} hingga ${lv.endDate}</div>
          <div class="text-[10px] text-teal-700 font-bold">${lv.totalDays} Hari Bekerja</div>
        </td>
        <td class="py-3 px-3 max-w-[200px] truncate text-slate-600">
          ${lv.reason}
        </td>
        <td class="py-3 px-3 text-center whitespace-nowrap">
          <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold ${
            lv.status === 'Diluluskan' ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' :
            lv.status === 'Ditolak' ? 'bg-rose-100 text-rose-800 border border-rose-300' :
            'bg-amber-100 text-amber-800 border border-amber-300 animate-pulse'
          }">
            ${lv.status}
          </span>
          ${lv.approvedBy ? `<div class="text-[9px] text-slate-400 mt-0.5">${lv.approvedBy}</div>` : ''}
        </td>
        <td class="py-3 px-3 text-center whitespace-nowrap">
          ${canApprove && lv.status === 'Menunggu Kelulusan' ? `
            <div class="flex items-center justify-center gap-1.5">
              <button
                type="button"
                class="approve-leave-btn bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[10px] px-2.5 py-1 rounded-lg transition-colors cursor-pointer"
                data-leave-id="${lv.id}"
              >
                Luluskan
              </button>
              <button
                type="button"
                class="reject-leave-btn bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-[10px] px-2 py-1 rounded-lg border border-rose-200 transition-colors cursor-pointer"
                data-leave-id="${lv.id}"
              >
                Tolak
              </button>
            </div>
          ` : `
            <span class="text-[10px] text-slate-400 font-medium">${lv.status === 'Menunggu Kelulusan' ? 'Menunggu Tindakan HR' : 'Selesai'}</span>
          `}
        </td>
      </tr>
    `).join('');

    // Attach leave approval buttons
    document.querySelectorAll('.approve-leave-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const leaveId = btn.getAttribute('data-leave-id');
        const leaveList = getStoredLeaves();
        const item = leaveList.find(l => l.id === leaveId);
        if (item) {
          item.status = 'Diluluskan';
          item.approvedBy = `Diluluskan oleh ${currentUserName} (${currentUserRoleDisplay})`;
          saveStoredLeaves(leaveList);
          renderLeavesTable();
          alert(`Permohonan cuti ${item.id} (${item.staffName}) telah DILULUSKAN oleh ${currentUserName}!`);
        }
      });
    });

    document.querySelectorAll('.reject-leave-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const leaveId = btn.getAttribute('data-leave-id');
        const leaveList = getStoredLeaves();
        const item = leaveList.find(l => l.id === leaveId);
        if (item) {
          item.status = 'Ditolak';
          item.approvedBy = `Ditolak oleh ${currentUserName} (${currentUserRoleDisplay})`;
          saveStoredLeaves(leaveList);
          renderLeavesTable();
          alert(`Permohonan cuti ${item.id} (${item.staffName}) telah DITOLAK.`);
        }
      });
    });
  }

  // -------------------------------------------------------------
  // CMS PACKAGE SLOTS MANAGEMENT (TALLY WITH WEB ITINERARY)
  // -------------------------------------------------------------
  function refreshCmsSlotsDisplay() {
    const slotsMap = getStoredSlots();
    initialTourPackages.forEach(pkg => {
      const container = document.getElementById(`cms-slots-list-${pkg.id}`);
      if (container) {
        const slots = slotsMap[pkg.id] || pkg.departureSlots || [];
        container.innerHTML = slots.map(s => `
          <div class="flex items-center justify-between bg-white px-2 py-1 rounded border border-slate-200 text-[10px]">
            <span class="font-semibold text-slate-900">${s.date}</span>
            <span class="font-bold px-1.5 py-0.2 rounded ${s.availablePax <= 4 ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'}">
              Baki ${s.availablePax} / ${s.totalPax} Pax
            </span>
          </div>
        `).join('');
      }
    });
  }

  // Slot Editor Modal Handlers
  const editSlotsModal = document.getElementById('edit-slots-modal');
  const closeEditSlotsBtn = document.getElementById('close-edit-slots-modal');
  const editSlotsForm = document.getElementById('edit-slots-form');

  function openEditSlotsModal(pkgId, pkgTitle) {
    if (!editSlotsModal) return;
    const pkg = initialTourPackages.find(p => p.id === pkgId);
    if (!pkg) return;

    const slotsMap = getStoredSlots();
    const currentSlots = slotsMap[pkgId] || pkg.departureSlots || [];

    const titleEl = document.getElementById('edit-slots-pkg-name');
    const idInput = document.getElementById('edit-slots-pkg-id');
    const rowsContainer = document.getElementById('slots-rows-container');

    if (titleEl) titleEl.textContent = `Pakej: ${pkg.title}`;
    if (idInput) idInput.value = pkgId;

    if (rowsContainer) {
      rowsContainer.innerHTML = currentSlots.map((slot, idx) => `
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-bold text-slate-800 text-xs">Tarikh Slot #${idx + 1}</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
            <div>
              <label class="block text-[10px] text-slate-600 font-bold mb-0.5">Tarikh Perlepasan</label>
              <input type="text" class="slot-date-input w-full bg-white border border-slate-300 rounded-lg p-1.5 text-xs font-bold text-slate-900" value="${slot.date}" required />
            </div>
            <div>
              <label class="block text-[10px] text-slate-600 font-bold mb-0.5">Baki Pax (Available)</label>
              <input type="number" class="slot-avail-input w-full bg-white border border-slate-300 rounded-lg p-1.5 text-xs font-bold text-emerald-700" value="${slot.availablePax}" min="0" max="100" required />
            </div>
            <div>
              <label class="block text-[10px] text-slate-600 font-bold mb-0.5">Kapasiti Penuh (Total)</label>
              <input type="number" class="slot-total-input w-full bg-white border border-slate-300 rounded-lg p-1.5 text-xs font-bold text-slate-900" value="${slot.totalPax}" min="1" max="100" required />
            </div>
          </div>
        </div>
      `).join('');
    }

    editSlotsModal.classList.remove('hidden');
    editSlotsModal.classList.add('flex');
  }

  document.querySelectorAll('.open-edit-slot-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const pId = btn.getAttribute('data-pkg-id');
      const pTitle = btn.getAttribute('data-pkg-title');
      if (pId) openEditSlotsModal(pId, pTitle || '');
    });
  });

  if (closeEditSlotsBtn && editSlotsModal) {
    closeEditSlotsBtn.addEventListener('click', () => {
      editSlotsModal.classList.add('hidden');
      editSlotsModal.classList.remove('flex');
    });
  }

  if (editSlotsForm && editSlotsModal) {
    editSlotsForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const pkgId = (document.getElementById('edit-slots-pkg-id')).value;
      if (!pkgId) return;

      const dateInputs = document.querySelectorAll('.slot-date-input');
      const availInputs = document.querySelectorAll('.slot-avail-input');
      const totalInputs = document.querySelectorAll('.slot-total-input');

      const updatedSlots = [];
      for (let i = 0; i < dateInputs.length; i++) {
        updatedSlots.push({
          date: (dateInputs[i]).value,
          availablePax: parseInt((availInputs[i]).value) || 0,
          totalPax: parseInt((totalInputs[i]).value) || 25
        });
      }

      const slotsMap = getStoredSlots();
      slotsMap[pkgId] = updatedSlots;
      saveStoredSlots(slotsMap);

      refreshCmsSlotsDisplay();
      editSlotsModal.classList.add('hidden');
      editSlotsModal.classList.remove('flex');

      alert(`Baki kekosongan pax untuk pakej ${pkgId} berjaya dikemas kini dan diselaraskan secara langsung dengan web awam!`);
    });
  }

  // -------------------------------------------------------------
  // RECONCILIATION & LEDGER ENGINE
  // -------------------------------------------------------------
  function renderLedgerAndRecon(bankData = DEFAULT_BANK_ROWS) {
    const ledgerItems = getStoredLedger();
    const ledgerTableTbody = document.getElementById('ledger-table-tbody');
    const reconLedgerTbody = document.getElementById('recon-ledger-tbody');
    const reconBankTbody = document.getElementById('recon-bank-tbody');

    if (!ledgerTableTbody || !reconLedgerTbody || !reconBankTbody) return;

    let totalLedgerInflows = 0;
    let totalBankInflows = 0;
    let matchCount = 0;
    let mismatchCount = 0;
    let discrepancyAmt = 0;

    const matchedLedgerRefs = new Set();

    ledgerItems.forEach(item => {
      totalLedgerInflows += item.debit;
    });

    bankData.forEach(bankRow => {
      if (bankRow.type === 'CREDIT') totalBankInflows += bankRow.amount;

      const matchedLedger = ledgerItems.find(l => {
        const amt = l.debit > 0 ? l.debit : l.credit;
        const bRef = (l.bookingRef || '').trim().toUpperCase();
        const bName = (l.customerName || '').trim().toUpperCase();
        const desc = (bankRow.desc || '').trim().toUpperCase();
        const exactAmt = Math.abs(amt - bankRow.amount) < 0.01;

        const refMatch = bRef.length >= 4 && desc.includes(bRef);
        const nameAndAmt = bName.length >= 3 && desc.includes(bName) && exactAmt;

        return refMatch || nameAndAmt;
      });

      if (matchedLedger) {
        matchCount++;
        matchedLedgerRefs.add(matchedLedger.bookingRef);
      } else {
        mismatchCount++;
        if (bankRow.type === 'CREDIT') discrepancyAmt += bankRow.amount;
      }
    });

    // Update Stat Cards
    const statLedgerEl = document.getElementById('stat-ledger-total');
    const statBankEl = document.getElementById('stat-bank-total');
    const statMatchEl = document.getElementById('stat-match-status');
    const statMatchSubEl = document.getElementById('stat-match-sub');
    const statMismatchEl = document.getElementById('stat-mismatch-count');
    const overviewStatLedger = document.getElementById('overview-stat-ledger');

    if (statLedgerEl) statLedgerEl.textContent = `RM ${totalLedgerInflows.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
    if (statBankEl) statBankEl.textContent = `RM ${totalBankInflows.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
    if (overviewStatLedger) overviewStatLedger.textContent = `RM ${totalLedgerInflows.toLocaleString(undefined, {minimumFractionDigits: 0})}`;

    if (mismatchCount > 0) {
      if (statMatchEl) {
        statMatchEl.textContent = `${matchCount} MATCH / ${mismatchCount} UNMATCHED`;
        statMatchEl.className = 'text-xl sm:text-2xl font-black text-rose-700';
      }
      if (statMatchSubEl) {
        statMatchSubEl.textContent = `${mismatchCount} transaksi bank belum dipadankan`;
        statMatchSubEl.className = 'text-[10px] sm:text-[11px] text-rose-700 font-bold mt-1 block';
      }
      if (statMismatchEl) {
        statMismatchEl.textContent = `RM ${discrepancyAmt.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
        statMismatchEl.className = 'text-xl sm:text-2xl font-black text-rose-700';
      }
    } else {
      if (statMatchEl) {
        statMatchEl.textContent = `100% TALLIED`;
        statMatchEl.className = 'text-xl sm:text-2xl font-black text-emerald-700';
      }
      if (statMatchSubEl) {
        statMatchSubEl.textContent = `Semua transaksi lejer sepadan dengan bank`;
        statMatchSubEl.className = 'text-[10px] sm:text-[11px] text-emerald-700 font-bold mt-1 block';
      }
      if (statMismatchEl) {
        statMismatchEl.textContent = `RM 0.00`;
        statMismatchEl.className = 'text-xl sm:text-2xl font-black text-slate-900';
      }
    }

    // Render 1: Main Ledger Table
    ledgerTableTbody.innerHTML = ledgerItems.map(led => `
      <tr class="hover:bg-slate-50 transition-colors">
        <td class="py-3 px-3 whitespace-nowrap">
          <div class="font-bold text-slate-900">${led.date}</div>
          <span class="text-[10px] text-teal-700 font-mono font-bold">${led.id}</span>
        </td>
        <td class="py-3 px-3 whitespace-nowrap">
          <div class="font-bold text-slate-800">${led.bookingRef}</div>
          <div class="text-[10px] text-slate-500">${led.accountCode}</div>
        </td>
        <td class="py-3 px-3 whitespace-nowrap">
          <div class="font-bold text-slate-900">${led.customerName}</div>
          <div class="text-slate-500 text-[11px] max-w-[200px] truncate">${led.description}</div>
        </td>
        <td class="py-3 px-3 whitespace-nowrap">
          <span class="bg-slate-100 text-slate-700 font-medium px-2 py-0.5 rounded text-[10px] border border-slate-200">
            ${led.paymentMethod}
          </span>
        </td>
        <td class="py-3 px-3 text-right font-extrabold text-emerald-700 whitespace-nowrap">
          ${led.debit > 0 ? `+RM ${led.debit.toLocaleString(undefined, {minimumFractionDigits: 2})}` : '-'}
        </td>
        <td class="py-3 px-3 text-right font-extrabold text-rose-700 whitespace-nowrap">
          ${led.credit > 0 ? `-RM ${led.credit.toLocaleString(undefined, {minimumFractionDigits: 2})}` : '-'}
        </td>
        <td class="py-3 px-3 text-center whitespace-nowrap">
          <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold ${
            matchedLedgerRefs.has(led.bookingRef) ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' : 'bg-amber-100 text-amber-800 border border-amber-200'
          }">
            ${matchedLedgerRefs.has(led.bookingRef) ? 'MATCHED' : 'PENDING'}
          </span>
        </td>
        <td class="py-3 px-3 text-center whitespace-nowrap">
          <button
            type="button"
            class="generate-invoice-btn px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 text-[10px] font-bold border border-slate-300 transition-colors cursor-pointer"
            data-booking-id="${led.bookingRef}"
            data-name="${led.customerName}"
            data-pkg="${led.description}"
            data-paid="${led.debit || led.credit}"
            data-total="${led.debit || led.credit}"
            data-pax="1"
          >
            Resit
          </button>
        </td>
      </tr>
    `).join('');

    // Render 2: Side-By-Side Recon Table (Left: System Ledger)
    reconLedgerTbody.innerHTML = ledgerItems.map(l => {
      const isMatched = matchedLedgerRefs.has(l.bookingRef);
      const amt = l.debit > 0 ? l.debit : l.credit;
      return `
        <tr class="${isMatched ? 'bg-emerald-50/50' : 'bg-amber-50/40'}">
          <td class="py-2.5 px-3 font-bold ${isMatched ? 'text-teal-800' : 'text-amber-800'} whitespace-nowrap">${l.bookingRef}</td>
          <td class="py-2.5 px-3 font-medium text-slate-900 whitespace-nowrap">${l.customerName}</td>
          <td class="py-2.5 px-3 font-bold text-slate-900 whitespace-nowrap">RM ${amt.toLocaleString(undefined, {minimumFractionDigits: 2})}</td>
          <td class="py-2.5 px-3 text-center whitespace-nowrap">
            <span class="px-2 py-0.5 rounded text-[9px] font-bold ${isMatched ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : 'bg-amber-100 text-amber-800 border border-amber-300'}">
              ${isMatched ? 'MATCH' : 'NO BANK'}
            </span>
          </td>
        </tr>
      `;
    }).join('');

    // Render 2: Side-By-Side Recon Table (Right: Bank Statement)
    reconBankTbody.innerHTML = bankData.map(b => {
      const isDebit = b.type === 'DEBIT';
      const isMatched = ledgerItems.some(l => {
        const amt = l.debit > 0 ? l.debit : l.credit;
        const bRef = (l.bookingRef || '').trim().toUpperCase();
        const bName = (l.customerName || '').trim().toUpperCase();
        const desc = (b.desc || '').trim().toUpperCase();
        const exactAmt = Math.abs(amt - b.amount) < 0.01;
        return (bRef.length >= 4 && desc.includes(bRef)) || (bName.length >= 3 && desc.includes(bName) && exactAmt);
      });

      return `
        <tr class="${isMatched ? 'bg-emerald-50/50' : 'bg-rose-50/40'}">
          <td class="py-2.5 px-3 font-medium text-slate-600 whitespace-nowrap">${b.date}</td>
          <td class="py-2.5 px-3 font-medium text-slate-900 max-w-[180px] truncate">${b.desc}</td>
          <td class="py-2.5 px-3 font-bold ${isDebit ? 'text-rose-700' : 'text-emerald-700'} whitespace-nowrap">
            ${isDebit ? '-' : '+'}RM ${b.amount.toLocaleString(undefined, {minimumFractionDigits: 2})}
          </td>
          <td class="py-2.5 px-3 text-center whitespace-nowrap">
            <span class="px-2 py-0.5 rounded text-[9px] font-bold ${isMatched ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : 'bg-rose-100 text-rose-800 border border-rose-300'}">
              ${isMatched ? 'MATCHED' : 'UNMATCHED'}
            </span>
          </td>
        </tr>
      `;
    }).join('');

    attachReceiptButtons();
  }

  // Trigger Auto Match Button
  const autoMatchBtn = document.getElementById('trigger-auto-match-btn');
  if (autoMatchBtn) {
    autoMatchBtn.addEventListener('click', () => {
      renderLedgerAndRecon(DEFAULT_BANK_ROWS);
      alert('Enjin Auto-Match berjaya dijalankan! Transaksi penyata bank Maybank Islamic telah dipadankan dengan rekod lejer sistem.');
    });
  }

  // Download Sample CSV
  const downloadCsvBtn = document.getElementById('download-sample-csv-btn');
  if (downloadCsvBtn) {
    downloadCsvBtn.addEventListener('click', () => {
      const csvContent = "data:text/csv;charset=utf-8," + 
        "Date,Description,Amount,Type,Reference\n" +
        DEFAULT_BANK_ROWS.map(r => `"${r.date}","${r.desc}",${r.amount},"${r.type}","MBB-2026"`).join("\n");
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", "penyata_bank_maybank_kembara_aug2026.csv");
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });
  }

  // Upload Bank Statement
  const uploadBankBtn = document.getElementById('upload-bank-btn');
  const bankFileInput = document.getElementById('bank-statement-file-input');
  if (uploadBankBtn && bankFileInput) {
    uploadBankBtn.addEventListener('click', () => {
      bankFileInput.click();
    });
  }

  if (bankFileInput) {
    bankFileInput.addEventListener('change', (e) => {
      const files = e.target.files;
      if (files && files.length > 0) {
        const file = files[0];
        const reader = new FileReader();
        reader.onload = function(evt) {
          const text = evt.target?.result;
          if (typeof text === 'string') {
            const lines = text.split('\n');
            const customRows = [];
            for (let i = 1; i < lines.length; i++) {
              const line = lines[i].trim();
              if (line) {
                const parts = line.split(',');
                if (parts.length >= 3) {
                  customRows.push({
                    date: parts[0]?.replace(/"/g, '') || '19/08/2026',
                    desc: parts[1]?.replace(/"/g, '') || 'BANK TRANSACTION',
                    amount: parseFloat(parts[2]?.replace(/"/g, '')) || 0,
                    type: (parts[3]?.includes('DEBIT') ? 'DEBIT' : 'CREDIT')
                  });
                }
              }
            }
            if (customRows.length > 0) {
              renderLedgerAndRecon(customRows);
              alert(`Berjaya memproses ${customRows.length} baris transaksi daripada fail penyata bank: ${file.name}`);
            } else {
              renderLedgerAndRecon(DEFAULT_BANK_ROWS);
              alert(`Penyata bank ${file.name} telah dimuat naik dan dipadankan dengan lejer.`);
            }
          }
        };
        reader.readAsText(file);
      }
    });
  }

  // -------------------------------------------------------------
  // CRM STATUS SYNC TO GENERAL LEDGER
  // -------------------------------------------------------------
  document.querySelectorAll('.crm-lead-status-select').forEach(select => {
    select.addEventListener('change', (e) => {
      const target = e.target;
      const bId = target.getAttribute('data-booking-id');
      const newStatus = target.value;
      const row = target.closest('tr');
      if (!row) return;

      const custName = row.getAttribute('data-customer') || 'Pelanggan';
      const pkgName = row.getAttribute('data-pkg') || 'Pakej Pelancongan';
      const total = parseFloat(row.getAttribute('data-total') || '0');

      let paidAmt = 0;
      let debitToAdd = 0;

      if (newStatus === 'Bayaran Penuh') {
        paidAmt = total;
        debitToAdd = total;
      } else if (newStatus === 'Deposit Selesai') {
        paidAmt = 1500;
        debitToAdd = 1500;
      }

      const paidEl = row.querySelector('.paid-display');
      if (paidEl) paidEl.textContent = `RM ${paidAmt.toLocaleString()}`;

      if (debitToAdd > 0) {
        const ledgerItems = getStoredLedger();
        const existingIdx = ledgerItems.findIndex(l => l.bookingRef === bId);
        
        const newLedgerEntry = {
          id: `LED-2026-0${ledgerItems.length + 1}`,
          bookingRef: bId || 'BK-2026-NEW',
          date: new Date().toISOString().split('T')[0],
          accountCode: pkgName.toLowerCase().includes('umrah') ? "4000 - Hasil Jualan Umrah VIP" : "4100 - Hasil Pakej Antarabangsa",
          customerName: custName,
          description: `${newStatus} ${pkgName} - ${custName}`,
          paymentMethod: "FPX Online",
          debit: debitToAdd,
          credit: 0,
          reconciled: true
        };

        if (existingIdx >= 0) {
          ledgerItems[existingIdx] = newLedgerEntry;
        } else {
          ledgerItems.push(newLedgerEntry);
        }

        saveStoredLedger(ledgerItems);
        renderLedgerAndRecon();
        alert(`Status ${bId} dikemas kini kepada "${newStatus}". Entri terimaan RM ${debitToAdd.toLocaleString()} telah dimasukkan ke Lejer Am.`);
      }
    });
  });

  // -------------------------------------------------------------
  // MODAL HANDLERS
  // -------------------------------------------------------------
  // Role Switcher Modal
  const roleSwitcherModal = document.getElementById('role-switcher-modal');
  const openRoleSwitcherBtn = document.getElementById('open-role-switcher-btn');
  const closeRoleSwitcherBtn = document.getElementById('close-role-switcher-modal');

  if (openRoleSwitcherBtn && roleSwitcherModal) {
