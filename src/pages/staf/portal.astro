---
import Layout from '../../layouts/Layout.astro';
import { companyInfo } from '../../data/company';
import { tourPackages } from '../../data/packages';
import { initialBookings, initialStaff, initialTripAssignments } from '../../data/portalData';
---

<Layout title="Portal Pengurusan & Operasi Staf | Kembara Travel">
  <div class="min-h-screen bg-slate-100 text-slate-900 flex flex-col font-sans">
    
    <!-- Top Navigation Header -->
    <header class="bg-white border-b border-slate-250 sticky top-0 z-40 shadow-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          
          <!-- Brand & System Badge -->
          <div class="flex items-center space-x-3">
            <a href="/" class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-sky-600 to-teal-600 flex items-center justify-center text-white font-bold shadow-md shadow-teal-600/20">
                KT
              </div>
              <div>
                <div class="text-base font-extrabold text-slate-900 leading-tight">
                  KEMBARA <span class="text-teal-700">OPERATIONS</span>
                </div>
                <div class="text-[10px] text-slate-500 font-bold uppercase tracking-wider">
                  Portal Staf & Pengurusan
                </div>
              </div>
            </a>
            <span class="hidden sm:inline-block bg-teal-50 text-teal-800 text-[10px] font-bold px-2.5 py-0.5 rounded-full border border-teal-200">
              v1.0 Cloudflare
            </span>
          </div>

          <!-- Staff Profile & Quick Actions -->
          <div class="flex items-center space-x-4">
            <div class="text-right hidden sm:block">
              <div id="display-staff-name" class="text-xs font-black text-slate-900">ZAIM ROSLI</div>
              <div id="display-staff-role" class="text-[11px] text-teal-700 font-bold">Admin Utama</div>
            </div>

            <a
              href="/"
              target="_blank"
              class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-xs font-bold text-slate-700 hover:text-slate-900 transition-colors border border-slate-300"
            >
              <svg class="w-3.5 h-3.5 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              <span>Lihat Web Awam</span>
            </a>

            <button
              id="logout-btn"
              type="button"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-bold transition-colors border border-rose-200 cursor-pointer"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              <span>Log Keluar</span>
            </button>
          </div>

        </div>
      </div>

      <!-- Tab Navigation Bar -->
      <div class="bg-slate-100/90 border-t border-slate-200 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto flex space-x-2 sm:space-x-3 overflow-x-auto py-2.5">
          
          <button
            type="button"
            data-tab="overview"
            class="tab-btn active px-4 py-2 rounded-xl text-xs font-bold transition-all bg-teal-700 text-white shadow-sm flex items-center gap-2 shrink-0 cursor-pointer"
          >
            <span>Ringkasan Dashboard</span>
          </button>

          <button
            type="button"
            data-tab="packages"
            class="tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-white text-slate-700 hover:bg-slate-200 border border-slate-200 hover:text-slate-900 flex items-center gap-2 shrink-0 cursor-pointer"
          >
            <span>Pengurusan Pakej (CMS)</span>
          </button>

          <button
            type="button"
            data-tab="bookings"
            class="tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-white text-slate-700 hover:bg-slate-200 border border-slate-200 hover:text-slate-900 flex items-center gap-2 shrink-0 cursor-pointer"
          >
            <span>Tempahan & Leads CRM</span>
          </button>

          <button
            type="button"
            data-tab="accounts"
            class="tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-white text-slate-700 hover:bg-slate-200 border border-slate-200 hover:text-slate-900 flex items-center gap-2 shrink-0 cursor-pointer"
          >
            <span>Invois & Resit Rasmi</span>
          </button>

          <button
            type="button"
            data-tab="hr"
            class="tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-white text-slate-700 hover:bg-slate-200 border border-slate-200 hover:text-slate-900 flex items-center gap-2 shrink-0 cursor-pointer"
          >
            <span>HR & Tugasan Trip</span>
          </button>

        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      
      <!-- ================= TAB 1: OVERVIEW ================= -->
      <section id="tab-overview" class="tab-pane space-y-8">
        
        <!-- Welcome Banner -->
        <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-sm">
          <div>
            <div class="text-xs font-bold text-teal-700 uppercase tracking-wider mb-1">
              Selamat Datang Kembali
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
              Papan Kawalan Operasi Kembara Travel
            </h1>
            <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-xl">
              Pantau status jualan pakej, kutipan bayaran jemaah, dan penugasan Mutawwif/Tour Leader secara langsung.
            </p>
          </div>
          <div class="flex items-center gap-3">
            <button
              type="button"
              id="quick-add-pkg-btn"
              class="bg-teal-700 hover:bg-teal-800 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-md transition-all flex items-center gap-2 cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              <span>Tambah Pakej Baru</span>
            </button>
          </div>
        </div>

        <!-- 4 Key Metrics Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          
          <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
            <div class="flex items-center justify-between text-slate-500 mb-3">
              <span class="text-xs font-bold uppercase tracking-wider">Hasil Jualan (Bulan Ini)</span>
              <span class="p-1.5 rounded-lg bg-teal-100 text-teal-800 font-extrabold text-xs">RM</span>
            </div>
            <div class="text-2xl font-black text-slate-900">RM 98,150</div>
            <div class="text-[11px] text-emerald-700 font-bold mt-1 flex items-center gap-1">
              <span>↑ 18.5%</span> <span class="text-slate-500 font-normal">berbanding bulan lepas</span>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
            <div class="flex items-center justify-between text-slate-500 mb-3">
              <span class="text-xs font-bold uppercase tracking-wider">Tempahan & Leads</span>
              <span class="p-1.5 rounded-lg bg-sky-100 text-sky-800 font-extrabold text-xs">PAX</span>
            </div>
            <div class="text-2xl font-black text-slate-900">15 Peserta</div>
            <div class="text-[11px] text-sky-700 font-bold mt-1">
              <span>4 Menunggu Bayaran Penuh</span>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
            <div class="flex items-center justify-between text-slate-500 mb-3">
              <span class="text-xs font-bold uppercase tracking-wider">Pakej Aktif di Web</span>
              <span class="p-1.5 rounded-lg bg-amber-100 text-amber-800 font-extrabold text-xs">PKG</span>
            </div>
            <div class="text-2xl font-black text-slate-900">{tourPackages.length} Pakej</div>
            <div class="text-[11px] text-amber-700 font-bold mt-1">
              <span>Semua sedia untuk tempahan</span>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
            <div class="flex items-center justify-between text-slate-500 mb-3">
              <span class="text-xs font-bold uppercase tracking-wider">Trip Berlepas Terdekat</span>
              <span class="p-1.5 rounded-lg bg-emerald-100 text-emerald-800 font-extrabold text-xs">TRIP</span>
            </div>
            <div class="text-2xl font-black text-slate-900">3 Kumpulan</div>
            <div class="text-[11px] text-emerald-700 font-bold mt-1">
              <span>Jepun (10 Okt) & Swiss (15 Okt)</span>
            </div>
          </div>

        </div>

        <!-- Recent Leads & Trip Schedule Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
          
          <!-- Recent Bookings Table (7 cols) -->
          <div class="lg:col-span-7 bg-white border border-slate-200 rounded-3xl p-6 shadow-sm">
            <div class="flex items-center justify-between mb-5">
              <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-teal-600"></span>
                Tempahan & Leads Terkini
              </h3>
              <button type="button" class="switch-to-tab text-xs text-teal-700 hover:text-teal-800 font-bold cursor-pointer" data-target="bookings">
                Lihat Semua →
              </button>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs">
                <thead>
                  <tr class="text-slate-600 bg-slate-50 border-b border-slate-200">
                    <th class="py-2.5 px-3 font-bold">Pelanggan</th>
                    <th class="py-2.5 px-3 font-bold">Pakej</th>
                    <th class="py-2.5 px-3 font-bold">Jumlah (RM)</th>
                    <th class="py-2.5 px-3 font-bold">Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {initialBookings.slice(0, 4).map((bk) => (
                    <tr class="hover:bg-slate-50 transition-colors">
                      <td class="py-3 px-3">
                        <div class="font-bold text-slate-900">{bk.customerName}</div>
                        <div class="text-[11px] text-slate-500">{bk.phone}</div>
                      </td>
                      <td class="py-3 px-3">
                        <div class="text-slate-800 font-semibold">{bk.packageName}</div>
                        <div class="text-[11px] text-teal-700 font-medium">{bk.pax} Pax • {bk.travelDate}</div>
                      </td>
                      <td class="py-3 px-3 font-extrabold text-slate-900">
                        RM {bk.totalAmount.toLocaleString()}
                      </td>
                      <td class="py-3 px-3">
                        <span class={`px-2.5 py-1 rounded-full text-[10px] font-bold ${
                          bk.status === 'Bayaran Penuh' ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' :
                          bk.status === 'Deposit Selesai' ? 'bg-sky-100 text-sky-800 border border-sky-300' :
                          'bg-amber-100 text-amber-800 border border-amber-300'
                        }`}>
                          {bk.status}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Trip Operations Schedule (5 cols) -->
          <div class="lg:col-span-5 bg-white border border-slate-200 rounded-3xl p-6 shadow-sm">
            <div class="flex items-center justify-between mb-5">
              <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
                Jadual Pelepasan Terdekat
              </h3>
              <button type="button" class="switch-to-tab text-xs text-teal-700 hover:text-teal-800 font-bold cursor-pointer" data-target="hr">
                Urus Trip →
              </button>
            </div>

            <div class="space-y-3.5">
              {initialTripAssignments.map((trip) => (
                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-900">{trip.tripTitle}</span>
                    <span class="text-[10px] font-bold bg-teal-100 text-teal-800 px-2 py-0.5 rounded border border-teal-300">
                      {trip.totalPax} Pax
                    </span>
                  </div>
                  <div class="text-[11px] text-slate-600">
                    Tarikh: <span class="text-slate-900 font-semibold">{trip.departureDate} - {trip.returnDate}</span>
                  </div>
                  <div class="text-[11px] text-slate-600 flex items-center justify-between pt-1 border-t border-slate-200">
                    <span>Lead: <strong class="text-teal-800">{trip.leadGuide}</strong></span>
                    <span class="text-slate-500 font-medium">{trip.flightNo}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>

      </section>


      <!-- ================= TAB 2: PENGURUSAN PAKEJ (CMS) ================= -->
      <section id="tab-packages" class="tab-pane hidden space-y-6">
        
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white border border-slate-200 p-6 rounded-3xl shadow-sm">
          <div>
            <h2 class="text-xl font-extrabold text-slate-900">Katalog Pakej Pelancongan (Live CMS)</h2>
            <p class="text-xs text-slate-600">Kemas kini harga, diskaun promosi, tarikh perlepasan atau tambah pakej baru.</p>
          </div>
          <button
            type="button"
            id="open-new-pkg-modal"
            class="bg-teal-700 hover:bg-teal-800 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-md transition-colors flex items-center gap-2 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            <span>+ Tambah Pakej Baru</span>
          </button>
        </div>

        <!-- Package List Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="cms-packages-container">
          {tourPackages.map((pkg) => (
            <div class="bg-white border border-slate-200 rounded-3xl p-5 shadow-sm space-y-4 flex flex-col justify-between hover:shadow-md transition-all">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[11px] font-bold text-teal-700 uppercase tracking-wider">{pkg.categoryLabel}</span>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                    Aktif di Web
                  </span>
                </div>
                <h3 class="text-base font-bold text-slate-900 line-clamp-1">{pkg.title}</h3>
                <p class="text-xs text-slate-600 line-clamp-2 mt-1">{pkg.subtitle}</p>
                
                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                  <div>
                    <span class="text-[10px] text-slate-500 font-medium block">Harga Jualan</span>
                    <span class="text-base font-extrabold text-teal-700">RM {pkg.price.toLocaleString()}</span>
                  </div>
                  <div class="text-right">
                    <span class="text-[10px] text-slate-500 font-medium block">Deposit</span>
                    <span class="font-bold text-slate-900">RM {pkg.deposit}</span>
                  </div>
                </div>

                <div class="mt-3 text-[11px] text-slate-600">
                  <span class="font-semibold text-slate-700">Perlepasan:</span>
                  <div class="flex flex-wrap gap-1 mt-1">
                    {pkg.nextDepartureDates.slice(0, 2).map(d => (
                      <span class="bg-slate-100 border border-slate-200 px-2 py-0.5 rounded text-[10px] text-slate-700 font-medium">{d}</span>
                    ))}
                  </div>
                </div>
              </div>

              <!-- CMS Actions -->
              <div class="pt-3 border-t border-slate-100 flex items-center gap-2">
                <button
                  type="button"
                  class="edit-pkg-btn flex-1 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold py-2 px-3 rounded-xl border border-slate-300 transition-colors cursor-pointer"
                  data-pkg-id={pkg.id}
                >
                  Edit Harga / Info
                </button>
                <button
                  type="button"
                  class="toggle-status-btn px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl border border-slate-300 cursor-pointer"
                  title="Toggle Sold Out"
                >
                  Sold Out
                </button>
              </div>
            </div>
          ))}
        </div>

      </section>


      <!-- ================= TAB 3: TEMPAHAN & LEADS CRM ================= -->
      <section id="tab-bookings" class="tab-pane hidden space-y-6">
        
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white border border-slate-200 p-6 rounded-3xl shadow-sm">
          <div>
            <h2 class="text-xl font-extrabold text-slate-900">Pengurusan Tempahan & Leads CRM</h2>
            <p class="text-xs text-slate-600">Pantau permohonan tempahan daripada borang web & WhatsApp pelanggan.</p>
          </div>
          <div class="flex items-center gap-2">
            <input
              type="text"
              id="crm-search-input"
              placeholder="Cari nama / no telefon / pakej..."
              class="bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2 text-xs text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-600"
            />
          </div>
        </div>

        <!-- CRM Leads Table -->
        <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead>
                <tr class="text-slate-600 bg-slate-50 border-b border-slate-200 pb-3">
                  <th class="py-3 px-3 font-bold">ID & Pelanggan</th>
                  <th class="py-3 px-3 font-bold">Pakej & Tarikh</th>
                  <th class="py-3 px-3 font-bold">Bil. Pax</th>
                  <th class="py-3 px-3 font-bold">Kewangan (Bayaran / Total)</th>
                  <th class="py-3 px-3 font-bold">Status Bayaran</th>
                  <th class="py-3 px-3 font-bold">Tindakan</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100" id="crm-leads-tbody">
                {initialBookings.map((bk) => (
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="py-3.5 px-3">
                      <span class="text-[10px] text-teal-700 font-mono font-bold block">{bk.id}</span>
                      <div class="font-bold text-slate-900 text-sm">{bk.customerName}</div>
                      <div class="text-slate-500">{bk.phone} • {bk.email}</div>
                    </td>
                    <td class="py-3.5 px-3">
                      <div class="font-bold text-slate-800">{bk.packageName}</div>
                      <div class="text-[11px] text-slate-500 font-medium">{bk.travelDate}</div>
                    </td>
                    <td class="py-3.5 px-3 font-bold text-slate-900">
                      {bk.pax} Orang
                    </td>
                    <td class="py-3.5 px-3">
                      <div class="font-extrabold text-emerald-700">RM {bk.paidAmount.toLocaleString()}</div>
                      <div class="text-[10px] text-slate-500 font-medium">drpd RM {bk.totalAmount.toLocaleString()}</div>
                    </td>
                    <td class="py-3.5 px-3">
                      <select class="lead-status-select bg-slate-50 border border-slate-300 text-xs text-slate-900 rounded-lg p-1.5 font-bold focus:ring-teal-600">
                        <option value="Pertanyaan Baru" selected={bk.status === 'Pertanyaan Baru'}>Pertanyaan Baru</option>
                        <option value="Deposit Selesai" selected={bk.status === 'Deposit Selesai'}>Deposit Selesai</option>
                        <option value="Bayaran Penuh" selected={bk.status === 'Bayaran Penuh'}>Bayaran Penuh</option>
                        <option value="Selesai Trip" selected={bk.status === 'Selesai Trip'}>Selesai Trip</option>
                      </select>
                    </td>
                    <td class="py-3.5 px-3">
                      <div class="flex items-center gap-2">
                        <a
                          href={`https://wa.me/6${bk.phone.replace(/[^0-9]/g, '')}?text=Salam%20${encodeURIComponent(bk.customerName)},%20ini%20adalah%20susulan%20rasmi%20daripada%20Kembara%20Travel%20berkenaan%20pakej%20${encodeURIComponent(bk.packageName)}.`}
                          target="_blank"
                          class="px-2.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[11px] shadow-sm transition-colors"
                          title="Hantar WhatsApp Follow-up"
                        >
                          WhatsApp
                        </a>
                        <button
                          type="button"
                          class="generate-invoice-btn px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 text-[11px] font-bold border border-slate-300 transition-colors cursor-pointer"
                          data-booking-id={bk.id}
                        >
                          Resit
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

      </section>


      <!-- ================= TAB 4: AKAUN & RESIT RASMI ================= -->
      <section id="tab-accounts" class="tab-pane hidden space-y-8">
        
        <div class="bg-white border border-slate-200 p-6 rounded-3xl shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h2 class="text-xl font-extrabold text-slate-900">Penjana Invois & Resit Rasmi (Invoicing Engine)</h2>
            <p class="text-xs text-slate-600">Jana dokumen invois & resit rasmi Kembara Travel untuk dihantar kepada pelanggan.</p>
          </div>
          <button
            type="button"
            onclick="window.print()"
            class="bg-teal-700 hover:bg-teal-800 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-md transition-colors flex items-center gap-2 cursor-pointer"
          >
