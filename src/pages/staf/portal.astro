        roleSwitcherModal.classList.remove('flex');
      }
    });
  });

  // New Staff Modal
  const staffModal = document.getElementById('new-staff-modal');
  const openStaffBtn1 = document.getElementById('open-new-staff-modal-btn');
  const openStaffBtn2 = document.getElementById('open-new-staff-modal-btn-2');
  const openStaffBtnOverview = document.getElementById('quick-add-staff-btn-overview');
  const closeStaffBtn = document.getElementById('close-new-staff-modal');
  const newStaffForm = document.getElementById('new-staff-form');

  function openStaffModal() {
    if (staffModal) {
      staffModal.classList.remove('hidden');
      staffModal.classList.add('flex');
      const staffList = getStoredStaff();
      const idInput = document.getElementById('modal-staff-id');
      if (idInput) idInput.value = `STF-0${staffList.length + 1}`;
    }
  }

  if (openStaffBtn1) openStaffBtn1.addEventListener('click', openStaffModal);
  if (openStaffBtn2) openStaffBtn2.addEventListener('click', openStaffModal);
  if (openStaffBtnOverview) openStaffBtnOverview.addEventListener('click', openStaffModal);
  if (closeStaffBtn && staffModal) {
    closeStaffBtn.addEventListener('click', () => {
      staffModal.classList.add('hidden');
      staffModal.classList.remove('flex');
    });
  }

  if (newStaffForm && staffModal) {
    newStaffForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const id = (document.getElementById('modal-staff-id')).value;
      const role = (document.getElementById('modal-staff-role')).value;
      const name = (document.getElementById('modal-staff-name')).value;
      const email = (document.getElementById('modal-staff-email')).value;
      const phone = (document.getElementById('modal-staff-phone')).value;
      const status = (document.getElementById('modal-staff-status')).value;

      const staffList = getStoredStaff();
      const newStaff = {
        id: id || `STF-0${staffList.length + 1}`,
        name: name,
        role: role,
        email: email,
        phone: phone,
        assignedTripsCount: role.includes('Mutawwif') ? 1 : 0,
        totalSalesDeals: role.includes('Sales') ? 5 : 0,
        status: status
      };

      staffList.push(newStaff);
      saveStoredStaff(staffList);
      renderStaffCards();
      populateLeaveStaffDropdown();

      staffModal.classList.add('hidden');
      staffModal.classList.remove('flex');
      newStaffForm.reset();
      alert(`Staf "${name}" (${role}) telah berjaya didaftarkan ke dalam direktori kakitangan!`);
    });
  }

  // Apply Leave Modal
  const leaveModal = document.getElementById('new-leave-modal');
  const openLeaveBtn1 = document.getElementById('open-apply-leave-modal-btn');
  const openLeaveBtnHeader = document.getElementById('header-apply-leave-btn');
  const closeLeaveBtn = document.getElementById('close-new-leave-modal');
  const newLeaveForm = document.getElementById('new-leave-form');

  function openLeaveModal() {
    if (leaveModal) {
      leaveModal.classList.remove('hidden');
      leaveModal.classList.add('flex');
      populateLeaveStaffDropdown();

      const startInput = document.getElementById('modal-leave-start');
      const endInput = document.getElementById('modal-leave-end');
      const today = new Date().toISOString().split('T')[0];
      if (startInput) startInput.value = today;
      if (endInput) endInput.value = today;
    }
  }

  if (openLeaveBtn1) openLeaveBtn1.addEventListener('click', openLeaveModal);
  if (openLeaveBtnHeader) openLeaveBtnHeader.addEventListener('click', openLeaveModal);
  if (closeLeaveBtn && leaveModal) {
    closeLeaveBtn.addEventListener('click', () => {
      leaveModal.classList.add('hidden');
      leaveModal.classList.remove('flex');
    });
  }

  if (newLeaveForm && leaveModal) {
    newLeaveForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const staffSelect = document.getElementById('modal-leave-staff');
      const selectedOption = staffSelect?.options[staffSelect.selectedIndex];
      const staffId = staffSelect?.value || 'STF-01';
      const staffName = selectedOption?.getAttribute('data-name') || currentUserName;
      const staffRole = selectedOption?.getAttribute('data-role') || currentUserRoleDisplay;

      const type = (document.getElementById('modal-leave-type')).value;
      const days = parseInt((document.getElementById('modal-leave-days')).value || '1');
      const start = (document.getElementById('modal-leave-start')).value;
      const end = (document.getElementById('modal-leave-end')).value;
      const reason = (document.getElementById('modal-leave-reason')).value;

      const leaveList = getStoredLeaves();
      const newLeave = {
        id: `LV-2026-0${leaveList.length + 1}`,
        staffId: staffId,
        staffName: staffName,
        staffRole: staffRole,
        leaveType: type,
        startDate: start,
        endDate: end,
        totalDays: days,
        reason: reason,
        status: 'Menunggu Kelulusan',
        appliedAt: new Date().toISOString().split('T')[0]
      };

      leaveList.unshift(newLeave);
      saveStoredLeaves(leaveList);
      renderLeavesTable();

      leaveModal.classList.add('hidden');
      leaveModal.classList.remove('flex');
      newLeaveForm.reset();
      switchTab('hr');
      alert(`Permohonan cuti (${type} - ${days} Hari) untuk ${staffName} telah dihantar kepada Admin & HR untuk kelulusan!`);
    });
  }

  // Manual Ledger Modal
  const ledgerModal = document.getElementById('new-ledger-modal');
  const openLedgerModalBtn = document.getElementById('open-manual-ledger-btn');
  const closeLedgerModalBtn = document.getElementById('close-new-ledger-modal');
  const newLedgerForm = document.getElementById('new-ledger-form');

  if (openLedgerModalBtn && ledgerModal) {
    openLedgerModalBtn.addEventListener('click', () => {
      ledgerModal.classList.remove('hidden');
      ledgerModal.classList.add('flex');
      const dateInput = document.getElementById('modal-led-date');
      if (dateInput) dateInput.value = new Date().toISOString().split('T')[0];
    });
  }
  if (closeLedgerModalBtn && ledgerModal) {
    closeLedgerModalBtn.addEventListener('click', () => {
      ledgerModal.classList.add('hidden');
      ledgerModal.classList.remove('flex');
    });
  }
  if (newLedgerForm && ledgerModal) {
    newLedgerForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const ref = (document.getElementById('modal-led-ref')).value;
      const date = (document.getElementById('modal-led-date')).value;
      const code = (document.getElementById('modal-led-code')).value;
      const cust = (document.getElementById('modal-led-customer')).value;
      const desc = (document.getElementById('modal-led-desc')).value;
      const type = (document.getElementById('modal-led-type')).value;
      const amt = parseFloat((document.getElementById('modal-led-amount')).value || '0');

      const isDebit = type === 'DEBIT';
      const ledgerItems = getStoredLedger();
      const newEntry = {
        id: `LED-2026-0${ledgerItems.length + 1}`,
        bookingRef: ref || 'MANUAL',
        date: date || new Date().toISOString().split('T')[0],
        accountCode: code,
        customerName: cust,
        description: desc,
        paymentMethod: "DuitNow Transfer",
        debit: isDebit ? amt : 0,
        credit: !isDebit ? amt : 0,
        reconciled: true
      };

      ledgerItems.push(newEntry);
      saveStoredLedger(ledgerItems);
      renderLedgerAndRecon();

      ledgerModal.classList.add('hidden');
      ledgerModal.classList.remove('flex');
      alert(`Entri Lejer "${desc}" sebanyak RM ${amt.toLocaleString()} berjaya direkodkan!`);
    });
  }

  // Invoice / Receipt Buttons
  function attachReceiptButtons() {
    document.querySelectorAll('.generate-invoice-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const bId = btn.getAttribute('data-booking-id') || 'INV-2026';
        const name = btn.getAttribute('data-name') || "Dato' Hj Razak & Keluarga";
        const phone = btn.getAttribute('data-phone') || '019-2819281';
        const pkg = btn.getAttribute('data-pkg') || 'Pakej Umrah VIP Musim Sejuk';
        const total = parseFloat(btn.getAttribute('data-total') || '31560');
        const paid = parseFloat(btn.getAttribute('data-paid') || '31560');
        const pax = parseInt(btn.getAttribute('data-pax') || '4');

        const balance = Math.max(0, total - paid);

        const rNo = document.getElementById('receipt-no-display');
        const rCustName = document.getElementById('receipt-cust-name');
        const rCustPhone = document.getElementById('receipt-cust-phone');
        const rPkgName = document.getElementById('receipt-pkg-name');
        const rPaxCount = document.getElementById('receipt-pax-count');
        const rItemTitle = document.getElementById('receipt-item-title');
        const rItemPax = document.getElementById('receipt-item-pax');
        const rItemUnitPrice = document.getElementById('receipt-item-unit-price');
        const rItemTotal = document.getElementById('receipt-item-total');
        const rGross = document.getElementById('receipt-total-gross');
        const rPaid = document.getElementById('receipt-total-paid');
        const rBalance = document.getElementById('receipt-balance-due');

        if (rNo) rNo.textContent = `NO: INV-2026-${bId.replace(/[^0-9]/g, '') || '8801'}`;
        if (rCustName) rCustName.textContent = name;
        if (rCustPhone) rCustPhone.textContent = `${phone} • Disahkan Rasmi`;
        if (rPkgName) rPkgName.textContent = pkg;
        if (rPaxCount) rPaxCount.textContent = `${pax} Peserta (Bilik Berkenaan)`;
        if (rItemTitle) rItemTitle.textContent = `${pkg} (Tiket Penerbangan + Hotel + Insurans)`;
        if (rItemPax) rItemPax.textContent = `${pax}`;
        if (rItemUnitPrice) rItemUnitPrice.textContent = (total / Math.max(1, pax)).toLocaleString(undefined, {minimumFractionDigits: 2});
        if (rItemTotal) rItemTotal.textContent = total.toLocaleString(undefined, {minimumFractionDigits: 2});
        if (rGross) rGross.textContent = `RM ${total.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
        if (rPaid) rPaid.textContent = `RM ${paid.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
        if (rBalance) rBalance.textContent = `RM ${balance.toLocaleString(undefined, {minimumFractionDigits: 2})}`;

        switchTab('accounts');
        const printable = document.getElementById('printable-receipt');
        if (printable) printable.scrollIntoView({ behavior: 'smooth' });
      });
    });
  }

  // Package Modal
  const pkgModal = document.getElementById('new-pkg-modal');
  const openPkgModalBtn = document.getElementById('open-new-pkg-modal');
  const quickAddPkgBtn = document.getElementById('quick-add-pkg-btn');
  const closePkgModalBtn = document.getElementById('close-new-pkg-modal');
  const newPkgForm = document.getElementById('new-package-form');

  if (openPkgModalBtn && pkgModal) {
    openPkgModalBtn.addEventListener('click', () => {
      pkgModal.classList.remove('hidden');
      pkgModal.classList.add('flex');
    });
  }
  if (quickAddPkgBtn && pkgModal) {
    quickAddPkgBtn.addEventListener('click', () => {
      pkgModal.classList.remove('hidden');
      pkgModal.classList.add('flex');
    });
  }
  if (closePkgModalBtn && pkgModal) {
    closePkgModalBtn.addEventListener('click', () => {
      pkgModal.classList.add('hidden');
      pkgModal.classList.remove('flex');
    });
  }
  if (newPkgForm && pkgModal) {
    newPkgForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const title = (document.getElementById('modal-pkg-title')).value;
      const price = (document.getElementById('modal-pkg-price')).value;
      const deposit = (document.getElementById('modal-pkg-deposit')).value;
      const duration = (document.getElementById('modal-pkg-duration')).value;

      const container = document.getElementById('cms-packages-container');
      if (container && title) {
        const newCard = document.createElement('div');
        newCard.className = 'bg-white border border-teal-500 rounded-2xl sm:rounded-3xl p-4 sm:p-5 space-y-4 shadow-md';
        newCard.innerHTML = `
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[11px] font-bold text-teal-700 uppercase tracking-wider">Pakej Baru</span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">Baru Ditambah</span>
            </div>
            <h3 class="text-base font-bold text-slate-900">${title}</h3>
            <p class="text-xs text-slate-600 mt-1">${duration}</p>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              <div>
                <span class="text-[10px] text-slate-500 font-medium block">Harga</span>
                <span class="text-base font-extrabold text-teal-700">RM ${Number(price).toLocaleString()}</span>
              </div>
              <div class="text-right">
                <span class="text-[10px] text-slate-500 font-medium block">Deposit</span>
                <span class="font-bold text-slate-900">RM ${Number(deposit).toLocaleString()}</span>
              </div>
            </div>
          </div>
          <div class="pt-3 border-t border-slate-100 text-xs text-emerald-700 font-bold">
            Berjaya disimpan dalam katalog
          </div>
        `;
        container.prepend(newCard);
      }
      pkgModal.classList.add('hidden');
      pkgModal.classList.remove('flex');
      switchTab('packages');
      alert(`Pakej "${title}" berjaya ditambah!`);
    });
  }
</script>
