<script>
  // Session check
  const sessionData = localStorage.getItem('kembara_staff_session');
  if (sessionData) {
    try {
      const parsed = JSON.parse(sessionData);
      const nameEl = document.getElementById('display-staff-name');
      const roleEl = document.getElementById('display-staff-role');
      if (nameEl) nameEl.textContent = parsed.name || 'STAF AKTIF';
      if (roleEl) roleEl.textContent = parsed.role || 'Admin';
    } catch (e) {
      console.error(e);
    }
  }

  // Logout button
  const logoutBtn = document.getElementById('logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      localStorage.removeItem('kembara_staff_session');
      window.location.href = '/staf/login/';
    });
  }

  // Tab switching
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const tabPanes = document.querySelectorAll<HTMLElement>('.tab-pane');

  function switchTab(tabId: string) {
    tabButtons.forEach(btn => {
      if (btn.getAttribute('data-tab') === tabId) {
        btn.classList.add('bg-teal-700', 'text-white', 'shadow-sm');
        btn.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');
      } else {
        btn.classList.remove('bg-teal-700', 'text-white', 'shadow-sm');
        btn.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
      }
    });

    tabPanes.forEach(pane => {
      if (pane.id === `tab-${tabId}`) {
        pane.classList.remove('hidden');
      } else {
        pane.classList.add('hidden');
      }
    });
  }

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab');
      if (tab) switchTab(tab);
    });
  });

  // Cross-tab button triggers
  document.querySelectorAll('.switch-to-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-target');
      if (target) switchTab(target);
    });
  });

  // -------------------------------------------------------------
  // RECONCILIATION & LEDGER ENGINE
  // -------------------------------------------------------------
  interface LocalLedgerItem {
    id: string;
    bookingRef: string;
    date: string;
    accountCode: string;
    customerName: string;
    description: string;
    paymentMethod: string;
    debit: number;
    credit: number;
    reconciled: boolean;
  }

  interface BankItem {
    date: string;
    desc: string;
    amount: number;
    type: 'CREDIT' | 'DEBIT';
  }

  const DEFAULT_LEDGER_ITEMS: LocalLedgerItem[] = [
    {
      id: "LED-2026-01",
      bookingRef: "BK-2026-001",
      date: "2026-08-10",
      accountCode: "4000 - Hasil Jualan Umrah VIP",
      customerName: "Dato' Hj Razak",
      description: "Bayaran Penuh Umrah VIP 4 Pax - Dato' Hj Razak",
      paymentMethod: "FPX Online",
      debit: 31560.00,
      credit: 0.00,
      reconciled: true
    },
    {
      id: "LED-2026-02",
      bookingRef: "BK-2026-002",
      date: "2026-08-14",
      accountCode: "4100 - Hasil Pakej Antarabangsa",
      customerName: "Dr. Farhan Kamil",
      description: "Deposit Trip Switzerland 3 Pax - Dr. Farhan Kamil",
      paymentMethod: "DuitNow Transfer",
      debit: 3000.00,
      credit: 0.00,
      reconciled: true
    },
    {
      id: "LED-2026-03",
      bookingRef: "BK-2026-003",
      date: "2026-08-17",
      accountCode: "4200 - Hasil Percutian Domestik",
      customerName: "Nurul Aisyah",
      description: "Deposit Semporna & Mabul 2 Pax - Nurul Aisyah",
      paymentMethod: "FPX Online",
      debit: 600.00,
      credit: 0.00,
      reconciled: true
    },
    {
      id: "LED-2026-04",
      bookingRef: "OPS-2026-101",
      date: "2026-08-18",
      accountCode: "5100 - Kos Tiket Penerbangan (Airlines)",
      customerName: "Saudi Arabian Airlines",
      description: "Bayaran Deposit Block Seat Saudi Airlines (SV 831)",
      paymentMethod: "DuitNow Transfer",
      debit: 0.00,
      credit: 12000.00,
      reconciled: true
    }
  ];

  const DEFAULT_BANK_ROWS: BankItem[] = [
    { date: "10/08/2026", desc: "DUITNOW TRANSFER FR DATO HJ RAZAK * BK-2026-001 UMRAH", amount: 31560.00, type: "CREDIT" },
    { date: "14/08/2026", desc: "TRANSFER FR DR FARHAN KAMIL * BK-2026-002 SWISS DEPOSIT", amount: 3000.00, type: "CREDIT" },
    { date: "17/08/2026", desc: "FPX PAYMENT NURUL AISYAH * BK-2026-003 SEMPORNA", amount: 600.00, type: "CREDIT" },
    { date: "18/08/2026", desc: "TRANSFER TO SAUDI ARABIAN AIRLINES * DEPOSIT SV831", amount: 12000.00, type: "DEBIT" },
    { date: "19/08/2026", desc: "CDM CASH DEPOSIT MAYBANK KLANG * UNIDENTIFIED DEPOSIT", amount: 1500.00, type: "CREDIT" }
  ];

  function getStoredLedger(): LocalLedgerItem[] {
    const raw = localStorage.getItem('kembara_ledger_data');
    if (raw) {
      try {
        return JSON.parse(raw);
      } catch (e) {
        return DEFAULT_LEDGER_ITEMS;
      }
    }
    return DEFAULT_LEDGER_ITEMS;
  }

  function saveStoredLedger(items: LocalLedgerItem[]) {
    localStorage.setItem('kembara_ledger_data', JSON.stringify(items));
  }

  function renderLedgerAndRecon(bankData: BankItem[] = DEFAULT_BANK_ROWS) {
    const ledgerItems = getStoredLedger();
    const ledgerTableTbody = document.getElementById('ledger-table-tbody');
    const reconLedgerTbody = document.getElementById('recon-ledger-tbody');
    const reconBankTbody = document.getElementById('recon-bank-tbody');

    if (!ledgerTableTbody || !reconLedgerTbody || !reconBankTbody) return;

    let totalLedgerInflows = 0;
    let totalBankInflows = 0;
    let matchCount = 0;
    let mismatchCount = 0;
    let discrepancyAmt = 0;

    const matchedLedgerRefs = new Set<string>();

    // Calculate totals and matches
    ledgerItems.forEach(item => {
      totalLedgerInflows += item.debit;
    });

    bankData.forEach(bankRow => {
      if (bankRow.type === 'CREDIT') {
        totalBankInflows += bankRow.amount;
      }

      // Check matching against ledger item
      const matchedLedger = ledgerItems.find(l => {
        const amt = l.debit > 0 ? l.debit : l.credit;
        const bRef = (l.bookingRef || '').trim().toUpperCase();
        const bName = (l.customerName || '').trim().toUpperCase();
        const desc = (bankRow.desc || '').trim().toUpperCase();
        const exactAmt = Math.abs(amt - bankRow.amount) < 0.01;

        const refMatch = bRef.length >= 4 && desc.includes(bRef);
        const nameAndAmt = bName.length >= 3 && desc.includes(bName) && exactAmt;

        return refMatch || nameAndAmt;
      });

      if (matchedLedger) {
        matchCount++;
        matchedLedgerRefs.add(matchedLedger.bookingRef);
      } else {
        mismatchCount++;
        if (bankRow.type === 'CREDIT') discrepancyAmt += bankRow.amount;
      }
    });

    // Update Stat Cards
    const statLedgerEl = document.getElementById('stat-ledger-total');
    const statBankEl = document.getElementById('stat-bank-total');
    const statMatchEl = document.getElementById('stat-match-status');
    const statMatchSubEl = document.getElementById('stat-match-sub');
    const statMismatchEl = document.getElementById('stat-mismatch-count');
    const overviewStatLedger = document.getElementById('overview-stat-ledger');

    if (statLedgerEl) statLedgerEl.textContent = `RM ${totalLedgerInflows.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
    if (statBankEl) statBankEl.textContent = `RM ${totalBankInflows.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
    if (overviewStatLedger) overviewStatLedger.textContent = `RM ${totalLedgerInflows.toLocaleString(undefined, {minimumFractionDigits: 0})}`;

    if (mismatchCount > 0) {
      if (statMatchEl) {
        statMatchEl.textContent = `${matchCount} MATCH / ${mismatchCount} UNMATCHED`;
        statMatchEl.className = 'text-xl sm:text-2xl font-black text-rose-700';
      }
      if (statMatchSubEl) {
        statMatchSubEl.textContent = `${mismatchCount} transaksi bank belum dipadankan`;
        statMatchSubEl.className = 'text-[10px] sm:text-[11px] text-rose-700 font-bold mt-1 block';
      }
      if (statMismatchEl) {
        statMismatchEl.textContent = `RM ${discrepancyAmt.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
        statMismatchEl.className = 'text-xl sm:text-2xl font-black text-rose-700';
      }
    } else {
      if (statMatchEl) {
        statMatchEl.textContent = `100% TALLIED`;
        statMatchEl.className = 'text-xl sm:text-2xl font-black text-emerald-700';
      }
      if (statMatchSubEl) {
        statMatchSubEl.textContent = `Semua transaksi lejer sepadan dengan bank`;
        statMatchSubEl.className = 'text-[10px] sm:text-[11px] text-emerald-700 font-bold mt-1 block';
      }
      if (statMismatchEl) {
        statMismatchEl.textContent = `RM 0.00`;
        statMismatchEl.className = 'text-xl sm:text-2xl font-black text-slate-900';
      }
    }

    // Render 1: Main Ledger Table (with whitespace-nowrap and min-w)
    ledgerTableTbody.innerHTML = ledgerItems.map(led => `
      <tr class="hover:bg-slate-50 transition-colors">
        <td class="py-3 px-3 whitespace-nowrap">
          <div class="font-bold text-slate-900">${led.date}</div>
          <span class="text-[10px] text-teal-700 font-mono font-bold">${led.id}</span>
        </td>
        <td class="py-3 px-3 whitespace-nowrap">
          <div class="font-bold text-slate-800">${led.bookingRef}</div>
          <div class="text-[10px] text-slate-500">${led.accountCode}</div>
        </td>
        <td class="py-3 px-3 whitespace-nowrap">
          <div class="font-bold text-slate-900">${led.customerName}</div>
          <div class="text-slate-500 text-[11px] max-w-[200px] truncate">${led.description}</div>
        </td>
        <td class="py-3 px-3 whitespace-nowrap">
          <span class="bg-slate-100 text-slate-700 font-medium px-2 py-0.5 rounded text-[10px] border border-slate-200">
            ${led.paymentMethod}
          </span>
        </td>
        <td class="py-3 px-3 text-right font-extrabold text-emerald-700 whitespace-nowrap">
          ${led.debit > 0 ? `+RM ${led.debit.toLocaleString(undefined, {minimumFractionDigits: 2})}` : '-'}
        </td>
        <td class="py-3 px-3 text-right font-extrabold text-rose-700 whitespace-nowrap">
          ${led.credit > 0 ? `-RM ${led.credit.toLocaleString(undefined, {minimumFractionDigits: 2})}` : '-'}
        </td>
        <td class="py-3 px-3 text-center whitespace-nowrap">
          <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold ${
            matchedLedgerRefs.has(led.bookingRef) ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' : 'bg-amber-100 text-amber-800 border border-amber-200'
          }">
            ${matchedLedgerRefs.has(led.bookingRef) ? 'MATCHED' : 'PENDING'}
          </span>
        </td>
        <td class="py-3 px-3 text-center whitespace-nowrap">
          <button
            type="button"
            class="generate-invoice-btn px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 text-[10px] font-bold border border-slate-300 transition-colors cursor-pointer"
            data-booking-id="${led.bookingRef}"
            data-name="${led.customerName}"
            data-pkg="${led.description}"
            data-paid="${led.debit || led.credit}"
            data-total="${led.debit || led.credit}"
            data-pax="1"
          >
            Resit
          </button>
        </td>
      </tr>
    `).join('');

    // Render 2: Side-By-Side Recon Table (Left: System Ledger)
    reconLedgerTbody.innerHTML = ledgerItems.map(l => {
      const isMatched = matchedLedgerRefs.has(l.bookingRef);
      const amt = l.debit > 0 ? l.debit : l.credit;
      return `
        <tr class="${isMatched ? 'bg-emerald-50/50' : 'bg-amber-50/40'}">
          <td class="py-2.5 px-3 font-bold ${isMatched ? 'text-teal-800' : 'text-amber-800'} whitespace-nowrap">${l.bookingRef}</td>
          <td class="py-2.5 px-3 font-medium text-slate-900 whitespace-nowrap">${l.customerName}</td>
          <td class="py-2.5 px-3 font-bold text-slate-900 whitespace-nowrap">RM ${amt.toLocaleString(undefined, {minimumFractionDigits: 2})}</td>
          <td class="py-2.5 px-3 text-center whitespace-nowrap">
            <span class="px-2 py-0.5 rounded text-[9px] font-bold ${isMatched ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : 'bg-amber-100 text-amber-800 border border-amber-300'}">
              ${isMatched ? 'MATCH' : 'NO BANK'}
            </span>
          </td>
        </tr>
      `;
    }).join('');

    // Render 2: Side-By-Side Recon Table (Right: Bank Statement)
    reconBankTbody.innerHTML = bankData.map(b => {
      const isDebit = b.type === 'DEBIT';
      const isMatched = ledgerItems.some(l => {
        const amt = l.debit > 0 ? l.debit : l.credit;
        const bRef = (l.bookingRef || '').trim().toUpperCase();
        const bName = (l.customerName || '').trim().toUpperCase();
        const desc = (b.desc || '').trim().toUpperCase();
        const exactAmt = Math.abs(amt - b.amount) < 0.01;
        return (bRef.length >= 4 && desc.includes(bRef)) || (bName.length >= 3 && desc.includes(bName) && exactAmt);
      });

      return `
        <tr class="${isMatched ? 'bg-emerald-50/50' : 'bg-rose-50/40'}">
          <td class="py-2.5 px-3 font-medium text-slate-600 whitespace-nowrap">${b.date}</td>
          <td class="py-2.5 px-3 font-medium text-slate-900 max-w-[180px] truncate">${b.desc}</td>
          <td class="py-2.5 px-3 font-bold ${isDebit ? 'text-rose-700' : 'text-emerald-700'} whitespace-nowrap">
            ${isDebit ? '-' : '+'}RM ${b.amount.toLocaleString(undefined, {minimumFractionDigits: 2})}
          </td>
          <td class="py-2.5 px-3 text-center whitespace-nowrap">
            <span class="px-2 py-0.5 rounded text-[9px] font-bold ${isMatched ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : 'bg-rose-100 text-rose-800 border border-rose-300'}">
              ${isMatched ? 'MATCHED' : 'UNMATCHED'}
            </span>
          </td>
        </tr>
      `;
    }).join('');

    // Reattach receipt buttons listeners
    attachReceiptButtons();
  }

  // Initial Ledger Render
  renderLedgerAndRecon();

  // Trigger Auto Match Button
  const autoMatchBtn = document.getElementById('trigger-auto-match-btn');
  if (autoMatchBtn) {
    autoMatchBtn.addEventListener('click', () => {
      renderLedgerAndRecon(DEFAULT_BANK_ROWS);
      alert('Enjin Auto-Match berjaya dijalankan! Transaksi penyata bank Maybank Islamic telah dipadankan dengan rekod lejer sistem.');
    });
  }

  // Download Sample CSV
  const downloadCsvBtn = document.getElementById('download-sample-csv-btn');
  if (downloadCsvBtn) {
    downloadCsvBtn.addEventListener('click', () => {
      const csvContent = "data:text/csv;charset=utf-8," + 
        "Date,Description,Amount,Type,Reference\n" +
        DEFAULT_BANK_ROWS.map(r => `"${r.date}","${r.desc}",${r.amount},"${r.type}","MBB-2026"`).join("\n");
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", "penyata_bank_maybank_kembara_aug2026.csv");
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });
  }

  // Real Bank File Upload handler
  const bankFileInput = document.getElementById('bank-statement-file-input') as HTMLInputElement;
  if (bankFileInput) {
    bankFileInput.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files && files.length > 0) {
        const file = files[0];
        const reader = new FileReader();
        reader.onload = function(evt) {
          const text = evt.target?.result as string;
          if (text) {
            const lines = text.split('\n');
            const customRows: BankItem[] = [];
            for (let i = 1; i < lines.length; i++) {
              const line = lines[i].trim();
              if (line) {
                const parts = line.split(',');
                if (parts.length >= 3) {
                  customRows.push({
                    date: parts[0]?.replace(/"/g, '') || '19/08/2026',
                    desc: parts[1]?.replace(/"/g, '') || 'BANK TRANSACTION',
                    amount: parseFloat(parts[2]?.replace(/"/g, '')) || 0,
                    type: (parts[3]?.includes('DEBIT') ? 'DEBIT' : 'CREDIT')
                  });
                }
              }
            }
            if (customRows.length > 0) {
              renderLedgerAndRecon(customRows);
              alert(`Berjaya memproses ${customRows.length} baris transaksi daripada fail penyata bank: ${file.name}`);
            } else {
              renderLedgerAndRecon(DEFAULT_BANK_ROWS);
              alert(`Penyata bank ${file.name} telah dimuat naik dan dipadankan dengan lejer.`);
            }
          }
        };
        reader.readAsText(file);
      }
    });
  }

  // -------------------------------------------------------------
  // CRM PAYMENT STATUS CHANGE -> AUTO SYNC TO GENERAL LEDGER
  // -------------------------------------------------------------
  document.querySelectorAll<HTMLSelectElement>('.crm-lead-status-select').forEach(select => {
    select.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement;
      const bId = target.getAttribute('data-booking-id');
      const newStatus = target.value;
      const row = target.closest('tr');
      if (!row) return;

      const custName = row.getAttribute('data-customer') || 'Pelanggan';
      const pkgName = row.getAttribute('data-pkg') || 'Pakej Pelancongan';
      const total = parseFloat(row.getAttribute('data-total') || '0');

      let paidAmt = 0;
      let debitToAdd = 0;

      if (newStatus === 'Bayaran Penuh') {
        paidAmt = total;
        debitToAdd = total;
      } else if (newStatus === 'Deposit Selesai') {
        paidAmt = 1500;
        debitToAdd = 1500;
      }

      const paidEl = row.querySelector('.paid-display');
      if (paidEl) paidEl.textContent = `RM ${paidAmt.toLocaleString()}`;

      if (debitToAdd > 0) {
        const ledgerItems = getStoredLedger();
        const existingIdx = ledgerItems.findIndex(l => l.bookingRef === bId);
        
        const newLedgerEntry: LocalLedgerItem = {
          id: `LED-2026-0${ledgerItems.length + 1}`,
          bookingRef: bId || 'BK-2026-NEW',
          date: new Date().toISOString().split('T')[0],
          accountCode: pkgName.toLowerCase().includes('umrah') ? "4000 - Hasil Jualan Umrah VIP" : "4100 - Hasil Pakej Antarabangsa",
          customerName: custName,
          description: `${newStatus} ${pkgName} - ${custName}`,
          paymentMethod: "FPX Online",
          debit: debitToAdd,
          credit: 0,
          reconciled: true
        };

        if (existingIdx >= 0) {
          ledgerItems[existingIdx] = newLedgerEntry;
        } else {
          ledgerItems.push(newLedgerEntry);
        }

        saveStoredLedger(ledgerItems);
        renderLedgerAndRecon();
        alert(`Status ${bId} dikemas kini kepada "${newStatus}". Entri transaksi RM ${debitToAdd.toLocaleString()} telah diautomasikan ke Lejer Am.`);
      }
    });
  });

  // -------------------------------------------------------------
  // MANUAL LEDGER ENTRY MODAL LOGIC
  // -------------------------------------------------------------
  const ledgerModal = document.getElementById('new-ledger-modal');
  const openLedgerModalBtn = document.getElementById('open-manual-ledger-btn');
  const closeLedgerModalBtn = document.getElementById('close-new-ledger-modal');
  const newLedgerForm = document.getElementById('new-ledger-form');

  if (openLedgerModalBtn && ledgerModal) {
    openLedgerModalBtn.addEventListener('click', () => {
      ledgerModal.classList.remove('hidden');
      ledgerModal.classList.add('flex');
      const dateInput = document.getElementById('modal-led-date') as HTMLInputElement;
      if (dateInput) dateInput.value = new Date().toISOString().split('T')[0];
    });
  }

  if (closeLedgerModalBtn && ledgerModal) {
    closeLedgerModalBtn.addEventListener('click', () => {
      ledgerModal.classList.add('hidden');
      ledgerModal.classList.remove('flex');
    });
  }

  if (newLedgerForm && ledgerModal) {
    newLedgerForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const ref = (document.getElementById('modal-led-ref') as HTMLInputElement)?.value;
      const date = (document.getElementById('modal-led-date') as HTMLInputElement)?.value;
      const code = (document.getElementById('modal-led-code') as HTMLSelectElement)?.value;
      const cust = (document.getElementById('modal-led-customer') as HTMLInputElement)?.value;
      const desc = (document.getElementById('modal-led-desc') as HTMLInputElement)?.value;
      const type = (document.getElementById('modal-led-type') as HTMLSelectElement)?.value;
      const amt = parseFloat((document.getElementById('modal-led-amount') as HTMLInputElement)?.value || '0');

      const isDebit = type === 'DEBIT';
      const ledgerItems = getStoredLedger();
      const newEntry: LocalLedgerItem = {
        id: `LED-2026-0${ledgerItems.length + 1}`,
        bookingRef: ref || 'MANUAL',
        date: date || new Date().toISOString().split('T')[0],
        accountCode: code,
        customerName: cust,
        description: desc,
        paymentMethod: "DuitNow Transfer",
        debit: isDebit ? amt : 0,
        credit: !isDebit ? amt : 0,
        reconciled: true
      };

      ledgerItems.push(newEntry);
      saveStoredLedger(ledgerItems);
      renderLedgerAndRecon();

      ledgerModal.classList.add('hidden');
      ledgerModal.classList.remove('flex');
      alert(`Entri Lejer "${desc}" sebanyak RM ${amt.toLocaleString()} berjaya direkodkan!`);
    });
  }

  // -------------------------------------------------------------
  // DYNAMIC RECEIPT GENERATOR TRIGGER
  // -------------------------------------------------------------
  function attachReceiptButtons() {
    document.querySelectorAll('.generate-invoice-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const bId = btn.getAttribute('data-booking-id') || 'INV-2026';
        const name = btn.getAttribute('data-name') || "Dato' Hj Razak & Keluarga";
        const phone = btn.getAttribute('data-phone') || '019-2819281';
        const pkg = btn.getAttribute('data-pkg') || 'Pakej Umrah VIP Musim Sejuk';
        const total = parseFloat(btn.getAttribute('data-total') || '31560');
        const paid = parseFloat(btn.getAttribute('data-paid') || '31560');
        const pax = parseInt(btn.getAttribute('data-pax') || '4');

        const balance = Math.max(0, total - paid);

        const rNo = document.getElementById('receipt-no-display');
        const rCustName = document.getElementById('receipt-cust-name');
        const rCustPhone = document.getElementById('receipt-cust-phone');
        const rPkgName = document.getElementById('receipt-pkg-name');
        const rPaxCount = document.getElementById('receipt-pax-count');
        const rItemTitle = document.getElementById('receipt-item-title');
        const rItemPax = document.getElementById('receipt-item-pax');
        const rItemUnitPrice = document.getElementById('receipt-item-unit-price');
        const rItemTotal = document.getElementById('receipt-item-total');
        const rGross = document.getElementById('receipt-total-gross');
        const rPaid = document.getElementById('receipt-total-paid');
        const rBalance = document.getElementById('receipt-balance-due');

        if (rNo) rNo.textContent = `NO: INV-2026-${bId.replace(/[^0-9]/g, '') || '8801'}`;
        if (rCustName) rCustName.textContent = name;
        if (rCustPhone) rCustPhone.textContent = `${phone} • Disahkan Rasmi`;
        if (rPkgName) rPkgName.textContent = pkg;
        if (rPaxCount) rPaxCount.textContent = `${pax} Peserta (Bilik Berkenaan)`;
        if (rItemTitle) rItemTitle.textContent = `${pkg} (Tiket Penerbangan + Hotel + Insurans)`;
        if (rItemPax) rItemPax.textContent = `${pax}`;
        if (rItemUnitPrice) rItemUnitPrice.textContent = (total / Math.max(1, pax)).toLocaleString(undefined, {minimumFractionDigits: 2});
        if (rItemTotal) rItemTotal.textContent = total.toLocaleString(undefined, {minimumFractionDigits: 2});
        if (rGross) rGross.textContent = `RM ${total.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
        if (rPaid) rPaid.textContent = `RM ${paid.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
        if (rBalance) rBalance.textContent = `RM ${balance.toLocaleString(undefined, {minimumFractionDigits: 2})}`;

        switchTab('accounts');
        const printable = document.getElementById('printable-receipt');
        if (printable) {
          printable.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  }

  // -------------------------------------------------------------
  // MODAL LOGIC FOR ADD PACKAGE
  // -------------------------------------------------------------
  const modal = document.getElementById('new-pkg-modal');
  const openModalBtn = document.getElementById('open-new-pkg-modal');
  const quickAddBtn = document.getElementById('quick-add-pkg-btn');
  const closeModalBtn = document.getElementById('close-new-pkg-modal');
  const newPkgForm = document.getElementById('new-package-form');

  function openModal() {
    if (modal) modal.classList.remove('hidden');
    if (modal) modal.classList.add('flex');
  }

  function closeModal() {
    if (modal) modal.classList.add('hidden');
    if (modal) modal.classList.remove('flex');
  }

  if (openModalBtn) openModalBtn.addEventListener('click', openModal);
  if (quickAddBtn) quickAddBtn.addEventListener('click', openModal);
  if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);

  if (newPkgForm) {
    newPkgForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const title = (document.getElementById('modal-pkg-title') as HTMLInputElement)?.value;
      const price = (document.getElementById('modal-pkg-price') as HTMLInputElement)?.value;
      const deposit = (document.getElementById('modal-pkg-deposit') as HTMLInputElement)?.value;
      const duration = (document.getElementById('modal-pkg-duration') as HTMLInputElement)?.value;
      const dates = (document.getElementById('modal-pkg-dates') as HTMLInputElement)?.value || 'Segera';

      const container = document.getElementById('cms-packages-container');
      if (container && title) {
        const newCard = document.createElement('div');
        newCard.className = 'bg-white border border-teal-500 rounded-2xl sm:rounded-3xl p-4 sm:p-5 space-y-4 shadow-md';
        newCard.innerHTML = `
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[11px] font-bold text-teal-700 uppercase tracking-wider">Pakej Baru</span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">Baru Ditambah</span>
            </div>
            <h3 class="text-base font-bold text-slate-900">${title}</h3>
            <p class="text-xs text-slate-600 mt-1">${duration}</p>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              <div>
                <span class="text-[10px] text-slate-500 font-medium block">Harga</span>
                <span class="text-base font-extrabold text-teal-700">RM ${Number(price).toLocaleString()}</span>
              </div>
              <div class="text-right">
                <span class="text-[10px] text-slate-500 font-medium block">Deposit</span>
                <span class="font-bold text-slate-900">RM ${Number(deposit).toLocaleString()}</span>
              </div>
            </div>
          </div>
          <div class="pt-3 border-t border-slate-100 text-xs text-emerald-700 font-bold">
            Berjaya disimpan dalam katalog
          </div>
        `;
        container.prepend(newCard);
      }
      closeModal();
      switchTab('packages');
      alert(`Pakej "${title}" berjaya ditambah!`);
    });
  }
</script>
