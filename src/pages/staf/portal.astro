<!-- Add/Edit Package Modal -->
<div id="new-pkg-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs">
  <div class="bg-white border border-slate-200 text-slate-900 rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl">
    <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-200">
      <h3 class="text-base font-bold text-slate-900">Tambah / Edit Pakej Pelancongan</h3>
      <button type="button" id="close-new-pkg-modal" class="text-slate-400 hover:text-slate-700 text-lg font-bold">✕</button>
    </div>
    <form id="new-package-form" class="space-y-3.5 text-xs">
      <div>
        <label class="block font-bold text-slate-700 mb-1">Tajuk Pakej *</label>
        <input type="text" id="modal-pkg-title" required placeholder="cth: Korea Autumn & Nami Island" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-slate-900 focus:bg-white" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Kategori *</label>
          <select id="modal-pkg-cat" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-slate-900 focus:bg-white font-medium">
            <option value="antarabangsa">Antarabangsa</option>
            <option value="umrah">Umrah & Ziarah</option>
            <option value="domestik">Domestik</option>
            <option value="pulau">Pulau & Santai</option>
          </select>
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Tempoh *</label>
          <input type="text" id="modal-pkg-duration" required placeholder="cth: 6 Hari 4 Malam" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-slate-900 focus:bg-white" />
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Harga Jualan (RM) *</label>
          <input type="number" id="modal-pkg-price" required placeholder="cth: 4290" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-slate-900 focus:bg-white" />
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Deposit (RM) *</label>
          <input type="number" id="modal-pkg-deposit" required placeholder="cth: 500" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-slate-900 focus:bg-white" />
        </div>
      </div>
      <div>
        <label class="block font-bold text-slate-700 mb-1">Tarikh Perlepasan (Asingkan dengan koma)</label>
        <input type="text" id="modal-pkg-dates" placeholder="cth: 12 Nov 2026, 05 Dis 2026" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-slate-900 focus:bg-white" />
      </div>
      <div class="pt-3">
        <button type="submit" class="w-full bg-teal-700 hover:bg-teal-800 text-white font-bold py-3 rounded-xl transition-all cursor-pointer">
          Simpan Pakej ke Katalog
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Session check
  const sessionData = localStorage.getItem('kembara_staff_session');
  if (sessionData) {
    try {
      const parsed = JSON.parse(sessionData);
      const nameEl = document.getElementById('display-staff-name');
      const roleEl = document.getElementById('display-staff-role');
      if (nameEl) nameEl.textContent = parsed.name || 'STAF AKTIF';
      if (roleEl) roleEl.textContent = parsed.role || 'Admin';
    } catch (e) {
      console.error(e);
    }
  }

  // Logout button
  const logoutBtn = document.getElementById('logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      localStorage.removeItem('kembara_staff_session');
      window.location.href = '/staf/login/';
    });
  }

  // Tab switching
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const tabPanes = document.querySelectorAll<HTMLElement>('.tab-pane');

  function switchTab(tabId: string) {
    tabButtons.forEach(btn => {
      if (btn.getAttribute('data-tab') === tabId) {
        btn.classList.add('bg-teal-700', 'text-white', 'shadow-sm');
        btn.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');
      } else {
        btn.classList.remove('bg-teal-700', 'text-white', 'shadow-sm');
        btn.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
      }
    });

    tabPanes.forEach(pane => {
      if (pane.id === `tab-${tabId}`) {
        pane.classList.remove('hidden');
      } else {
        pane.classList.add('hidden');
      }
    });
  }

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab');
      if (tab) switchTab(tab);
    });
  });

  // Cross-tab button triggers
  document.querySelectorAll('.switch-to-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-target');
      if (target) switchTab(target);
    });
  });

  // Modal logic for Add Package
  const modal = document.getElementById('new-pkg-modal');
  const openModalBtn = document.getElementById('open-new-pkg-modal');
  const quickAddBtn = document.getElementById('quick-add-pkg-btn');
  const closeModalBtn = document.getElementById('close-new-pkg-modal');
  const newPkgForm = document.getElementById('new-package-form');

  function openModal() {
    if (modal) modal.classList.remove('hidden');
    if (modal) modal.classList.add('flex');
  }

  function closeModal() {
    if (modal) modal.classList.add('hidden');
    if (modal) modal.classList.remove('flex');
  }

  if (openModalBtn) openModalBtn.addEventListener('click', openModal);
  if (quickAddBtn) quickAddBtn.addEventListener('click', openModal);
  if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);

  if (newPkgForm) {
    newPkgForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const title = (document.getElementById('modal-pkg-title') as HTMLInputElement)?.value;
      const price = (document.getElementById('modal-pkg-price') as HTMLInputElement)?.value;
      const deposit = (document.getElementById('modal-pkg-deposit') as HTMLInputElement)?.value;
      const duration = (document.getElementById('modal-pkg-duration') as HTMLInputElement)?.value;
      const dates = (document.getElementById('modal-pkg-dates') as HTMLInputElement)?.value || 'Segera';

      const container = document.getElementById('cms-packages-container');
      if (container && title) {
        const newCard = document.createElement('div');
        newCard.className = 'bg-white border border-teal-500 rounded-3xl p-5 space-y-4 shadow-md';
        newCard.innerHTML = `
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[11px] font-bold text-teal-700 uppercase tracking-wider">Pakej Baru</span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">Baru Ditambah</span>
            </div>
            <h3 class="text-base font-bold text-slate-900">${title}</h3>
            <p class="text-xs text-slate-600 mt-1">${duration}</p>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              <div>
                <span class="text-[10px] text-slate-500 font-medium block">Harga</span>
                <span class="text-base font-extrabold text-teal-700">RM ${Number(price).toLocaleString()}</span>
              </div>
              <div class="text-right">
                <span class="text-[10px] text-slate-500 font-medium block">Deposit</span>
                <span class="font-bold text-slate-900">RM ${Number(deposit).toLocaleString()}</span>
              </div>
            </div>
          </div>
          <div class="pt-3 border-t border-slate-100 text-xs text-emerald-700 font-bold">
            Berjaya disimpan dalam katalog
          </div>
        `;
        container.prepend(newCard);
      }
      closeModal();
      switchTab('packages');
      alert(`Pakej "${title}" berjaya ditambah!`);
    });
  }

  // Quick Receipt Trigger from CRM Leads
  document.querySelectorAll('.generate-invoice-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      switchTab('accounts');
      const printable = document.getElementById('printable-receipt');
      if (printable) {
        printable.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
</script>
