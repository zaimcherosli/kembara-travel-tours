---
import { companyInfo } from '../data/company';
---

<header class="sticky top-0 z-50 w-full">
  <!-- Top announcement & contact bar -->
  <div class="bg-slate-900 text-slate-300 text-xs py-2 px-4 border-b border-slate-800 hidden md:block">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-6">
        <span class="flex items-center gap-1.5 text-emerald-400 font-medium">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          Lesen MOTAC: {companyInfo.motacNo}
        </span>
        <span class="text-slate-400">|</span>
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Talian Rasmi: <a href={`tel:${companyInfo.phoneDisplay.replace(/[^0-9+]/g, '')}`} class="hover:text-white transition-colors">{companyInfo.phoneDisplay}</a>
        </span>
        <span class="text-slate-400">|</span>
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {companyInfo.officeHours}
        </span>
      </div>
      <div class="flex items-center space-x-3">
        <a href={`https://wa.me/${companyInfo.whatsappNumber}?text=Hai%20Kembara%20Travel,%20saya%20ingin%20tahu%20pakej%20percutian.`} target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300 font-semibold flex items-center gap-1">
          <span>WhatsApp Khidmat Pelanggan</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <nav class="glass-nav border-b border-slate-200/80 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-20">
        
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-sky-600 to-teal-500 flex items-center justify-center text-white shadow-md shadow-sky-500/20 group-hover:scale-105 transition-transform duration-300">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
          </div>
          <div>
            <div class="text-xl font-extrabold tracking-tight text-slate-900 leading-tight">
              KEMBARA <span class="text-teal-600 font-bold">TRAVEL</span>
            </div>
            <div class="text-[11px] font-medium text-slate-500 tracking-wider uppercase">
              Tours & Umrah VIP
            </div>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <div class="hidden lg:flex items-center space-x-7">
          <a href="#pakej" class="text-sm font-semibold text-slate-700 hover:text-teal-600 transition-colors">
            Pakej Percutian
          </a>
          <a href="#destinasi" class="text-sm font-semibold text-slate-700 hover:text-teal-600 transition-colors">
            Destinasi
          </a>
          <a href="#umrah" class="text-sm font-semibold text-slate-700 hover:text-teal-600 transition-colors flex items-center gap-1">
            <span>Umrah VIP</span>
            <span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-1.5 py-0.5 rounded-full">Musim Sejuk</span>
          </a>
          <a href="#kenapa-kami" class="text-sm font-semibold text-slate-700 hover:text-teal-600 transition-colors">
            Kelebihan
          </a>
          <a href="#ulasan" class="text-sm font-semibold text-slate-700 hover:text-teal-600 transition-colors">
            Ulasan
          </a>
          <a href="#faq" class="text-sm font-semibold text-slate-700 hover:text-teal-600 transition-colors">
            Soalan Lazim
          </a>
          <a href="#pertanyaan" class="text-sm font-semibold text-slate-700 hover:text-teal-600 transition-colors">
            Hubungi
          </a>
        </div>

        <!-- CTA Action Buttons -->
        <div class="hidden sm:flex items-center gap-3">
          <a
            href={`https://wa.me/${companyInfo.whatsappNumber}?text=Hai%20Kembara%20Travel,%20saya%20berminat%20untuk%20dapatkan%20sebut%20harga%20pakej.`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2.5 rounded-xl shadow-md shadow-emerald-600/20 hover:shadow-lg hover:shadow-emerald-600/30 transition-all duration-200 text-sm"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Tempah Sekarang</span>
          </a>
        </div>

        <!-- Mobile menu hamburger button -->
        <div class="flex items-center lg:hidden">
          <button
            id="mobile-menu-btn"
            type="button"
            class="p-2.5 rounded-xl text-slate-700 hover:text-teal-600 hover:bg-slate-100 transition-colors focus:outline-none"
            aria-label="Buka Menu"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>

      </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white/95 backdrop-blur-xl px-4 pt-3 pb-6 space-y-2">
      <a href="#pakej" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-slate-800 hover:bg-slate-100 hover:text-teal-600">
        Pakej Percutian
      </a>
      <a href="#destinasi" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-slate-800 hover:bg-slate-100 hover:text-teal-600">
        Destinasi Pilihan
      </a>
      <a href="#umrah" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-slate-800 hover:bg-slate-100 hover:text-teal-600">
        Umrah & Ziarah VIP
      </a>
      <a href="#kenapa-kami" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-slate-800 hover:bg-slate-100 hover:text-teal-600">
        Kelebihan & Jaminan Kami
      </a>
      <a href="#ulasan" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-slate-800 hover:bg-slate-100 hover:text-teal-600">
        Ulasan Pelanggan (4.9★)
      </a>
      <a href="#faq" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-slate-800 hover:bg-slate-100 hover:text-teal-600">
        Soalan Lazim (FAQ)
      </a>
      <a href="#pertanyaan" class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-slate-800 hover:bg-slate-100 hover:text-teal-600">
        Borang Pertanyaan / Sebut Harga
      </a>
      <div class="pt-3">
        <a
          href={`https://wa.me/${companyInfo.whatsappNumber}?text=Hai%20Kembara%20Travel,%20saya%20ingin%20tempah%20pakej%20percutian.`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl shadow-md text-center"
        >
          <span>Hubungi WhatsApp Rasmi</span>
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>
