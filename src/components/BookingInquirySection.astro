---
import { companyInfo } from '../data/company';
import { tourPackages } from '../data/packages';
---

<section id="pertanyaan" class="py-20 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Context & Contact Card -->
      <div class="lg:col-span-5 space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-teal-50 text-teal-700 text-xs font-bold uppercase tracking-wider">
          Borang Pertanyaan & Tempahan
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
          Ingin Dapatkan Sebut Harga Khas / Custom Trip?
        </h2>
        <p class="text-slate-600 text-sm leading-relaxed">
          Isi borang di sebelah untuk mendapatkan cadangan itinerari, tarikh kekosongan, atau sebut harga khas bagi rombongan keluarga & syarikat. Kami akan balas sepantas kilat!
        </p>

        <!-- Direct Contact Cards -->
        <div class="space-y-3 pt-2">
          <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="w-10 h-10 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold text-slate-900">Talian WhatsApp / Telefon</div>
              <div class="text-xs text-slate-600">{companyInfo.whatsappDisplay} / {companyInfo.phoneDisplay}</div>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="w-10 h-10 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold text-slate-900">Emel Rasmi</div>
              <div class="text-xs text-slate-600">{companyInfo.email}</div>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="w-10 h-10 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold text-slate-900">Ibu Pejabat (HQ)</div>
              <div class="text-xs text-slate-600 leading-relaxed">{companyInfo.address}</div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Form -->
      <div class="lg:col-span-7 bg-slate-50 border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm">
        
        <form id="inquiry-form" class="space-y-4">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Full Name -->
            <div class="space-y-1">
              <label for="form-name" class="text-xs font-bold text-slate-700 block">Nama Penuh *</label>
              <input
                type="text"
                id="form-name"
                required
                placeholder="cth: Ahmad Zulkifli"
                class="w-full bg-white border border-slate-300 rounded-xl p-3 text-xs text-slate-900 focus:ring-2 focus:ring-teal-500 focus:outline-none"
              />
            </div>

            <!-- Phone / WhatsApp -->
            <div class="space-y-1">
              <label for="form-phone" class="text-xs font-bold text-slate-700 block">No. Telefon / WhatsApp *</label>
              <input
                type="tel"
                id="form-phone"
                required
                placeholder="cth: 0123456789"
                class="w-full bg-white border border-slate-300 rounded-xl p-3 text-xs text-slate-900 focus:ring-2 focus:ring-teal-500 focus:outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Package Selection -->
            <div class="space-y-1">
              <label for="form-package" class="text-xs font-bold text-slate-700 block">Pakej Pilihan *</label>
              <select
                id="form-package"
                class="w-full bg-white border border-slate-300 rounded-xl p-3 text-xs text-slate-900 focus:ring-2 focus:ring-teal-500 focus:outline-none font-medium"
              >
                <option value="Custom Trip / Pertanyaan Umum">Pakej Khas (Custom Trip) / Umum</option>
                {tourPackages.map(pkg => (
                  <option value={pkg.title}>{pkg.title} ({pkg.duration})</option>
                ))}
              </select>
            </div>

            <!-- Pax Count -->
            <div class="space-y-1">
              <label for="form-pax" class="text-xs font-bold text-slate-700 block">Bilangan Peserta (Pax) *</label>
              <select
                id="form-pax"
                class="w-full bg-white border border-slate-300 rounded-xl p-3 text-xs text-slate-900 focus:ring-2 focus:ring-teal-500 focus:outline-none font-medium"
              >
                <option value="1 - 2 Pax (Pasangan / Solo)">1 - 2 Pax (Pasangan / Solo)</option>
                <option value="3 - 5 Pax (Keluarga Kecil)">3 - 5 Pax (Keluarga Kecil)</option>
                <option value="6 - 10 Pax (Keluarga Besar)">6 - 10 Pax (Keluarga Besar)</option>
                <option value="11 - 25 Pax (Rombongan)">11 - 25 Pax (Rombongan)</option>
                <option value="26+ Pax (Korporat / Syarikat)">26+ Pax (Korporat / Syarikat)</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Target Travel Month -->
            <div class="space-y-1">
              <label for="form-month" class="text-xs font-bold text-slate-700 block">Cadangan Bulan Perlepasan</label>
              <input
                type="text"
                id="form-month"
                placeholder="cth: Cuti Sekolah Disember 2026"
                class="w-full bg-white border border-slate-300 rounded-xl p-3 text-xs text-slate-900 focus:ring-2 focus:ring-teal-500 focus:outline-none"
              />
            </div>

            <!-- Email (Optional) -->
            <div class="space-y-1">
              <label for="form-email" class="text-xs font-bold text-slate-700 block">Emel (Pilihan)</label>
              <input
                type="email"
                id="form-email"
                placeholder="cth: ahmad@gmail.com"
                class="w-full bg-white border border-slate-300 rounded-xl p-3 text-xs text-slate-900 focus:ring-2 focus:ring-teal-500 focus:outline-none"
              />
            </div>
          </div>

          <!-- Notes / Special Request -->
          <div class="space-y-1">
            <label for="form-notes" class="text-xs font-bold text-slate-700 block">Permintaan Khas / Pertanyaan</label>
            <textarea
              id="form-notes"
              rows="3"
              placeholder="cth: Ingin bilik connecting room untuk anak-anak, atau nak minta pakej private family tour..."
              class="w-full bg-white border border-slate-300 rounded-xl p-3 text-xs text-slate-900 focus:ring-2 focus:ring-teal-500 focus:outline-none"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button
              type="submit"
              class="w-full bg-gradient-to-r from-teal-600 to-emerald-600 hover:from-teal-700 hover:to-emerald-700 text-white font-bold py-3.5 px-6 rounded-2xl shadow-lg shadow-teal-600/20 transition-all flex items-center justify-center gap-2 cursor-pointer text-sm"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              <span>Hantar Pertanyaan Terus ke WhatsApp Admin</span>
            </button>
          </div>

          <p class="text-[11px] text-slate-500 text-center">
            🔒 Maklumat anda adalah sulit dan hanya digunakan untuk urusan tempahan rasmi.
          </p>

        </form>

      </div>

    </div>

  </div>
</section>

<script define:vars={{ whatsappNumber: companyInfo.whatsappNumber }}>
  const form = document.getElementById('inquiry-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('form-name') as HTMLInputElement)?.value || '';
      const phone = (document.getElementById('form-phone') as HTMLInputElement)?.value || '';
      const pkg = (document.getElementById('form-package') as HTMLSelectElement)?.value || '';
      const pax = (document.getElementById('form-pax') as HTMLSelectElement)?.value || '';
      const month = (document.getElementById('form-month') as HTMLInputElement)?.value || 'Fleksibel';
      const notes = (document.getElementById('form-notes') as HTMLTextAreaElement)?.value || 'Tiada nota tambahan';

      const message = `Salam Kembara Travel, saya ingin bertanyakan sebut harga/tempahan:%0A%0A` +
        `👤 *Nama:* ${encodeURIComponent(name)}%0A` +
        `📞 *No Tel:* ${encodeURIComponent(phone)}%0A` +
        `✈️ *Pakej:* ${encodeURIComponent(pkg)}%0A` +
        `👥 *Bilangan Pax:* ${encodeURIComponent(pax)}%0A` +
        `📅 *Bulan Perlepasan:* ${encodeURIComponent(month)}%0A` +
        `📝 *Nota/Permintaan:* ${encodeURIComponent(notes)}`;

      window.open(`https://wa.me/${whatsappNumber}?text=${message}`, '_blank');
    });
  }
</script>
