---
import { companyInfo } from '../data/company';
---

<footer class="bg-slate-950 text-slate-400 text-xs border-t border-slate-800">
  
  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      
      <!-- Brand & License Column (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-600 to-teal-500 flex items-center justify-center text-white shadow-md">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
          </div>
          <div>
            <div class="text-lg font-extrabold tracking-tight text-white leading-tight">
              KEMBARA <span class="text-teal-400">TRAVEL</span>
            </div>
            <div class="text-[10px] font-medium text-slate-400 uppercase">
              Tours & Umrah VIP
            </div>
          </div>
        </a>

        <p class="text-slate-400 text-xs leading-relaxed max-w-sm">
          {companyInfo.name} ({companyInfo.ssmNo}). Agensi pelancongan berlesen di bawah Kementerian Pelancongan, Seni & Budaya Malaysia (MOTAC No: <span class="text-teal-300 font-semibold">{companyInfo.motacNo}</span>).
        </p>

        <!-- Trust Badges Row -->
        <div class="flex flex-wrap items-center gap-2 pt-2">
          <span class="bg-slate-900 border border-slate-800 text-teal-400 text-[11px] font-semibold px-2.5 py-1 rounded-lg">
            MOTAC Licensed
          </span>
          <span class="bg-slate-900 border border-slate-800 text-amber-400 text-[11px] font-semibold px-2.5 py-1 rounded-lg">
            MATTA Member
          </span>
          <span class="bg-slate-900 border border-slate-800 text-sky-400 text-[11px] font-semibold px-2.5 py-1 rounded-lg">
            BUMITRA
          </span>
        </div>
      </div>

      <!-- Links: Pakej Percutian -->
      <div class="space-y-3">
        <h4 class="text-white font-bold text-sm uppercase tracking-wider">Kategori Pakej</h4>
        <ul class="space-y-2">
          <li><a href="#pakej" class="hover:text-teal-400 transition-colors">Pakej Antarabangsa</a></li>
          <li><a href="#umrah" class="hover:text-teal-400 transition-colors">Pakej Umrah VIP</a></li>
          <li><a href="#pakej" class="hover:text-teal-400 transition-colors">Percutian Domestik</a></li>
          <li><a href="#pakej" class="hover:text-teal-400 transition-colors">Pakej Pulau & Resort</a></li>
          <li><a href="#pertanyaan" class="hover:text-teal-400 transition-colors">Private & Corporate Tour</a></li>
        </ul>
      </div>

      <!-- Links: Destinasi Popular -->
      <div class="space-y-3">
        <h4 class="text-white font-bold text-sm uppercase tracking-wider">Destinasi Hangat</h4>
        <ul class="space-y-2">
          <li><a href="#pakej" class="hover:text-teal-400 transition-colors">Switzerland & Alps</a></li>
          <li><a href="#pakej" class="hover:text-teal-400 transition-colors">Tokyo & Kyoto Jepun</a></li>
          <li><a href="#umrah" class="hover:text-teal-400 transition-colors">Makkah & Madinah</a></li>
          <li><a href="#pakej" class="hover:text-teal-400 transition-colors">Kundasang Sabah</a></li>
          <li><a href="#pakej" class="hover:text-teal-400 transition-colors">Semporna & Mabul</a></li>
        </ul>
      </div>

      <!-- Links: Hubungi Kami -->
      <div class="space-y-3">
        <h4 class="text-white font-bold text-sm uppercase tracking-wider">Hubungi Kami</h4>
        <ul class="space-y-2 text-slate-400">
          <li class="flex items-center gap-2">
            <span class="text-teal-400 font-semibold text-[11px]">Tel:</span>
            <a href={`tel:${companyInfo.phoneDisplay.replace(/[^0-9+]/g, '')}`} class="hover:text-white">{companyInfo.phoneDisplay}</a>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-400 font-semibold text-[11px]">WA:</span>
            <a href={`https://wa.me/${companyInfo.whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="hover:text-white">{companyInfo.whatsappDisplay}</a>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-sky-400 font-semibold text-[11px]">Emel:</span>
            <a href={`mailto:${companyInfo.email}`} class="hover:text-white">{companyInfo.email}</a>
          </li>
          <li class="pt-2 text-[11px] leading-relaxed text-slate-500">
            {companyInfo.address}
          </li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Bottom Copyright & Cloudflare/GitHub Credits -->
  <div class="border-t border-slate-900 bg-black/40 py-6 px-4">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-slate-500 text-[11px]">
      <div>
        © {new Date().getFullYear()} {companyInfo.name}. Hak Cipta Terpelihara.
      </div>
      <div class="flex items-center space-x-4">
        <span>Hosted on <span class="text-orange-400 font-semibold">Cloudflare Pages</span></span>
        <span>•</span>
        <a href="/staf/login" class="text-slate-400 hover:text-teal-400 font-semibold transition-colors flex items-center gap-1">
          <span>Akses Portal Staf</span>
        </a>
      </div>
    </div>
  </div>

</footer>
