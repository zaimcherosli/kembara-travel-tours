---
import type { TourPackage } from '../data/packages';
import { companyInfo } from '../data/company';

interface Props {
  pkg: TourPackage;
}

const { pkg } = Astro.props;

const discountPercentage = pkg.originalPrice 
  ? Math.round(((pkg.originalPrice - pkg.price) / pkg.originalPrice) * 100) 
  : null;

const whatsappMessage = encodeURIComponent(
  `Salam Kembara Travel, saya berminat dengan pakej "${pkg.title}" (${pkg.duration}). Boleh kongsikan tarikh perlepasan terdekat & slot kekosongan?`
);
---

<div
  class="package-item bg-white rounded-3xl overflow-hidden border border-slate-200/90 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group h-full"
  data-category={pkg.category}
  data-destination={pkg.destination.toLowerCase() + ' ' + pkg.country.toLowerCase() + ' ' + pkg.title.toLowerCase()}
  data-price={pkg.price}
>
  <!-- Card Image & Badges -->
  <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
    <img
      src={pkg.image}
      alt={pkg.title}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-black/20"></div>

    <!-- Top Badges -->
    <div class="absolute top-3.5 left-3.5 flex flex-wrap gap-2 items-center">
      {pkg.badge && (
        <span class="bg-gradient-to-r from-amber-500 to-orange-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow-md">
          {pkg.badge}
        </span>
      )}
      {discountPercentage && (
        <span class="bg-rose-500 text-white text-xs font-bold px-2.5 py-1 rounded-full shadow-md">
          Jimat {discountPercentage}%
        </span>
      )}
    </div>

    <!-- Category Pill Top Right -->
    <div class="absolute top-3.5 right-3.5">
      <span class="bg-slate-900/80 backdrop-blur-md text-white text-xs font-medium px-3 py-1 rounded-full border border-white/20">
        {pkg.categoryLabel}
      </span>
    </div>

    <!-- Duration & Flight Included Bottom -->
    <div class="absolute bottom-3.5 left-3.5 right-3.5 flex justify-between items-center text-white text-xs font-semibold">
      <span class="flex items-center gap-1 bg-black/50 backdrop-blur-md px-2.5 py-1 rounded-lg">
        <svg class="w-3.5 h-3.5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {pkg.duration}
      </span>
      {pkg.flightIncluded && (
        <span class="flex items-center gap-1 bg-teal-600/90 backdrop-blur-md px-2.5 py-1 rounded-lg text-white">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
          Tiket Penerbangan Termasuk
        </span>
      )}
    </div>
  </div>

  <!-- Card Body -->
  <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
    <div>
      <!-- Rating & Destination -->
      <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
        <span class="flex items-center gap-1 text-slate-600 font-medium">
          <svg class="w-3.5 h-3.5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          {pkg.destination}
        </span>
        <span class="flex items-center gap-1 text-amber-600 font-bold">
          {pkg.rating} <span class="text-slate-400 font-normal">({pkg.reviewCount} ulasan)</span>
        </span>
      </div>

      <!-- Title -->
      <h3 class="text-lg font-bold text-slate-900 group-hover:text-teal-600 transition-colors line-clamp-2 leading-snug mb-2">
        {pkg.title}
      </h3>

      <!-- Subtitle -->
      <p class="text-xs text-slate-600 line-clamp-2 mb-4 leading-relaxed">
        {pkg.subtitle}
      </p>

      <!-- Key Highlights -->
      <div class="space-y-1.5 mb-5 pb-4 border-b border-slate-100">
        {pkg.highlights.slice(0, 3).map((hl) => (
          <div class="flex items-start gap-2 text-xs text-slate-600">
            <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="line-clamp-1">{hl}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Pricing & Action Buttons -->
    <div>
      <div class="flex items-end justify-between mb-4">
        <div>
          <span class="text-[11px] text-slate-500 font-medium block">Harga Serendah Dari</span>
          <div class="flex items-baseline gap-2">
            <span class="text-2xl font-extrabold text-teal-700">
              RM {pkg.price.toLocaleString()}
            </span>
            <span class="text-xs text-slate-500 font-normal">/ pax</span>
          </div>
        </div>
        {pkg.originalPrice && (
          <div class="text-right">
            <span class="text-xs text-slate-400 line-through">
              RM {pkg.originalPrice.toLocaleString()}
            </span>
            <span class="text-[11px] text-emerald-600 font-bold block">
              Deposit RM {pkg.deposit}
            </span>
          </div>
        )}
      </div>

      <!-- Button Grid -->
      <div class="grid grid-cols-2 gap-2.5">
        <button
          type="button"
          class="open-modal-btn w-full bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold py-2.5 px-3 rounded-xl text-xs transition-colors cursor-pointer text-center"
          data-package-id={pkg.id}
        >
          Lihat Itinerary
        </button>
        <a
          href={`https://wa.me/${companyInfo.whatsappNumber}?text=${whatsappMessage}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2.5 px-3 rounded-xl text-xs transition-all shadow-sm flex items-center justify-center gap-1.5 text-center"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Tempah WA</span>
        </a>
      </div>
    </div>
  </div>
</div>
