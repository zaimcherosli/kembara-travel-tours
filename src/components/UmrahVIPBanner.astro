---
import { companyInfo } from '../data/company';

const waUmrahMsg = encodeURIComponent(
  "Salam Kembara Travel, saya ingin bertanyakan tentang Pakej Umrah VIP Musim Sejuk & tarikh kekosongan."
);
---

<section id="umrah" class="py-20 bg-gradient-to-b from-slate-900 via-emerald-950 to-slate-900 text-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="bg-gradient-to-r from-emerald-900/80 to-slate-900/90 border border-emerald-500/30 rounded-3xl p-8 sm:p-12 shadow-2xl backdrop-blur-xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left Content -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 text-xs font-bold uppercase tracking-wider">
            🕋 Pakej Eksklusif Umrah 1448H / 2026-2027
          </div>
          
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
            Ibadah Penuh Ketenangan Bersama <span class="text-emerald-400">Pakej Umrah VIP</span> & Bimbingan Mutawwif
          </h2>
          
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Rasai keselesaan beribadah di Tanah Suci dengan penginapan hotel bertaraf 5 Bintang di hadapan dataran Masjidil Haram & Masjid Nabawi, penerbangan terus, serta perjalanan pantas Haramain High-Speed Train.
          </p>

          <!-- Key Highlights List -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm text-slate-200">
            <div class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold text-base">✓</span>
              <span>Hotel Makkah Clock Tower (0m)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold text-base">✓</span>
              <span>Kereta Api Laju Haramain Train</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold text-base">✓</span>
              <span>Penerbangan Terus Saudia / MAS</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold text-base">✓</span>
              <span>Bimbingan Mutawwif Siswazah Madinah</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold text-base">✓</span>
              <span>Full Board Buffet Makanan Melayu</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold text-base">✓</span>
              <span>Percuma Beg Eksklusif & 5L Zamzam</span>
            </div>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-wrap gap-4 pt-4">
            <a
              href={`https://wa.me/${companyInfo.whatsappNumber}?text=${waUmrahMsg}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold px-6 py-3 rounded-2xl shadow-lg shadow-emerald-500/25 transition-all text-sm"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              <span>Dapatkan Brosur Umrah VIP</span>
            </a>
            <a
              href="#pakej"
              class="inline-flex items-center gap-2 bg-slate-800 hover:bg-slate-700 text-white font-semibold px-6 py-3 rounded-2xl border border-slate-700 transition-all text-sm"
            >
              <span>Lihat Senarai Tarikh</span>
            </a>
          </div>
        </div>

        <!-- Right Image Showcase -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border-2 border-emerald-500/30">
            <img
              src="https://images.unsplash.com/photo-1591604129939-f1efa4d9f7fa?auto=format&fit=crop&w=1000&q=80"
              alt="Makkah Holy Kaaba"
              class="w-full h-80 lg:h-96 object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 bg-slate-900/90 backdrop-blur-md p-4 rounded-2xl border border-emerald-500/20">
              <div class="text-xs text-emerald-400 font-bold uppercase">Pakej 12 Hari 10 Malam</div>
              <div class="text-sm font-extrabold text-white">Umrah VIP Musim Sejuk 1448H</div>
              <div class="text-xs text-slate-300">Harga Dari <span class="text-emerald-400 font-bold">RM 7,890 / pax</span> (Deposit RM 1,000)</div>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
