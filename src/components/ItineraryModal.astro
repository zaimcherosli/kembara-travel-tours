---
import { tourPackages } from '../data/packages';
import { companyInfo } from '../data/company';
---

<!-- Global Modal Container -->
<div
  id="itinerary-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-3 sm:p-6 overflow-y-auto bg-slate-950/80 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div class="relative w-full max-w-4xl bg-white rounded-3xl shadow-2xl overflow-hidden my-8 transform transition-all flex flex-col max-h-[90vh]">
    
    <!-- Modal Header -->
    <div class="sticky top-0 z-20 bg-slate-900 text-white px-6 py-4 flex items-center justify-between border-b border-slate-800">
      <div>
        <span id="modal-category" class="text-xs font-bold text-teal-400 uppercase tracking-wider">Antarabangsa</span>
        <h3 id="modal-title" class="text-lg sm:text-xl font-extrabold text-white leading-tight">Nama Pakej Percutian</h3>
      </div>
      <button
        id="close-modal-btn"
        type="button"
        class="w-9 h-9 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center transition-colors focus:outline-none"
        aria-label="Tutup"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Modal Content Scroll Area -->
    <div class="overflow-y-auto p-6 space-y-6 flex-1 text-slate-700">
      
      <!-- Key Meta Banner -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 bg-slate-50 p-4 rounded-2xl border border-slate-200">
        <div>
          <span class="text-xs text-slate-500 font-medium block">Tempoh</span>
          <span id="modal-duration" class="text-sm font-bold text-slate-900">8 Hari 6 Malam</span>
        </div>
        <div>
          <span class="text-xs text-slate-500 font-medium block">Harga Dari</span>
          <span id="modal-price" class="text-sm font-extrabold text-teal-600">RM 8,490 / pax</span>
        </div>
        <div>
          <span class="text-xs text-slate-500 font-medium block">Deposit</span>
          <span id="modal-deposit" class="text-sm font-bold text-slate-900">RM 1,000</span>
        </div>
        <div>
          <span class="text-xs text-slate-500 font-medium block">Penerbangan</span>
          <span id="modal-flight" class="text-sm font-bold text-slate-900">Termasuk</span>
        </div>
      </div>

      <!-- Highlights List -->
      <div>
        <h4 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-teal-500"></span>
          Tarikan Utama Pakej
        </h4>
        <div id="modal-highlights" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-700 bg-teal-50/50 p-4 rounded-2xl border border-teal-100">
          <!-- Injected via JS -->
        </div>
      </div>

      <!-- Day-by-Day Itinerary -->
      <div>
        <h4 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-teal-500"></span>
          Jadual Perjalanan Harian (Itinerary)
        </h4>
        <div id="modal-itinerary-list" class="space-y-4 border-l-2 border-teal-200 pl-4 sm:pl-6 ml-2 sm:ml-4">
          <!-- Injected via JS -->
        </div>
      </div>

      <!-- Inclusions & Exclusions Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4 border-t border-slate-200">
        <div>
          <h4 class="text-xs font-bold text-emerald-700 uppercase tracking-wider mb-3 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Pakej Termasuk (Inclusions)
          </h4>
          <ul id="modal-inclusions" class="space-y-2 text-xs text-slate-600">
            <!-- Injected via JS -->
          </ul>
        </div>
        <div>
          <h4 class="text-xs font-bold text-rose-700 uppercase tracking-wider mb-3 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            Tidak Termasuk (Exclusions)
          </h4>
          <ul id="modal-exclusions" class="space-y-2 text-xs text-slate-600">
            <!-- Injected via JS -->
          </ul>
        </div>
      </div>

      <!-- Departure Dates List -->
      <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200">
        <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-2">
          Tarikh Perlepasan Terdekat:
        </h4>
        <div id="modal-dates" class="flex flex-wrap gap-2 text-xs font-semibold">
          <!-- Injected via JS -->
        </div>
      </div>

    </div>

    <!-- Modal Footer Actions -->
    <div class="sticky bottom-0 z-20 bg-slate-100 px-6 py-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="text-xs text-slate-500 text-center sm:text-left">
        Perlukan bantuan atau sebut harga khas kumpulan? Hubungi staf kami.
      </div>
      <div class="flex items-center gap-3 w-full sm:w-auto">
        <button
          id="modal-close-secondary"
          type="button"
          class="flex-1 sm:flex-none px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-xs font-semibold hover:bg-slate-200 transition-colors"
        >
          Tutup
        </button>
        <a
          id="modal-whatsapp-cta"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-6 py-2.5 rounded-xl shadow-md shadow-emerald-600/20 transition-all"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Tempah Pakej Ini via WhatsApp</span>
        </a>
      </div>
    </div>

  </div>
</div>

<script define:vars={{ packages: tourPackages, whatsappNumber: companyInfo.whatsappNumber }}>
  const modal = document.getElementById('itinerary-modal');
  const closeBtn = document.getElementById('close-modal-btn');
  const closeSecondary = document.getElementById('modal-close-secondary');

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }
  }

  function openPackageModal(pkgId) {
    const pkg = packages.find(p => p.id === pkgId);
    if (!pkg || !modal) return;

    document.getElementById('modal-category').textContent = pkg.categoryLabel;
    document.getElementById('modal-title').textContent = pkg.title;
    document.getElementById('modal-duration').textContent = pkg.duration;
    document.getElementById('modal-price').textContent = `RM ${pkg.price.toLocaleString()} / pax`;
    document.getElementById('modal-deposit').textContent = `RM ${pkg.deposit}`;
    document.getElementById('modal-flight').textContent = pkg.flightIncluded ? 'Termasuk Tiket' : 'Pilihan Sendiri';

    // Highlights
    const hlContainer = document.getElementById('modal-highlights');
    hlContainer.innerHTML = pkg.highlights.map(h => `
      <div class="flex items-center gap-2">
        <span class="text-teal-600 font-bold">✓</span>
        <span>${h}</span>
      </div>
    `).join('');

    // Itinerary List
    const itinContainer = document.getElementById('modal-itinerary-list');
    itinContainer.innerHTML = pkg.itinerary.map(item => `
      <div class="relative mb-6 last:mb-0">
        <div class="absolute -left-[25px] sm:-left-[33px] top-0 w-4 h-4 rounded-full bg-teal-500 border-2 border-white"></div>
        <div class="font-bold text-slate-900 text-sm mb-1">Hari ${item.day}: ${item.title}</div>
        <p class="text-xs text-slate-600 mb-2 leading-relaxed">${item.description}</p>
        ${item.meals ? `<div class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded inline-block">Sajian: ${item.meals}</div>` : ''}
      </div>
    `).join('');

    // Inclusions
    const incContainer = document.getElementById('modal-inclusions');
    incContainer.innerHTML = pkg.inclusions.map(inc => `
      <li class="flex items-start gap-2">
        <span class="text-emerald-500 font-bold">✓</span>
        <span>${inc}</span>
      </li>
    `).join('');

    // Exclusions
    const excContainer = document.getElementById('modal-exclusions');
    excContainer.innerHTML = pkg.exclusions.map(exc => `
      <li class="flex items-start gap-2">
        <span class="text-rose-500 font-bold">✕</span>
        <span>${exc}</span>
      </li>
    `).join('');

    // Dates
    const datesContainer = document.getElementById('modal-dates');
    datesContainer.innerHTML = pkg.nextDepartureDates.map(date => `
      <span class="bg-slate-200 text-slate-800 px-3 py-1 rounded-lg">${date}</span>
    `).join('');

    // WhatsApp CTA
    const waCTA = document.getElementById('modal-whatsapp-cta');
    const waMsg = encodeURIComponent(`Salam Kembara Travel, saya ingin bertanyakan tempahan bagi pakej "${pkg.title}" (${pkg.duration}).`);
    waCTA.setAttribute('href', `https://wa.me/${whatsappNumber}?text=${waMsg}`);

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  // Bind all card modal buttons
  document.addEventListener('click', (e) => {
    const target = e.target.closest('.open-modal-btn');
    if (target) {
      const pkgId = target.getAttribute('data-package-id');
      if (pkgId) openPackageModal(pkgId);
    }
  });

  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (closeSecondary) closeSecondary.addEventListener('click', closeModal);
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>
