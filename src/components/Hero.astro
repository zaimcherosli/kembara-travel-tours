---
import { companyInfo } from '../data/company';
---

<section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden bg-slate-950 py-20 lg:py-28">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=2000&q=80"
      alt="Travel World Background"
      class="w-full h-full object-cover object-center scale-105 animate-pulse duration-[10000ms]"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-900/60 backdrop-blur-[2px]"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
    
    <!-- Trust Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-teal-500/15 border border-teal-400/30 text-teal-300 text-xs sm:text-sm font-semibold mb-6 backdrop-blur-md">
      <span class="w-2 h-2 rounded-full bg-teal-400 animate-ping"></span>
      <span>Agensi Pelancongan Berlesen MOTAC ({companyInfo.motacNo})</span>
    </div>

    <!-- Main Title -->
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight max-w-4xl leading-[1.15] mb-6">
      Jelajahi Dunia & Cipta <span class="bg-gradient-to-r from-teal-400 via-sky-300 to-amber-300 bg-clip-text text-transparent">Memori Terindah</span> Bersama Kami
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-lg lg:text-xl text-slate-300 max-w-2xl font-normal leading-relaxed mb-10">
      Pakej percutian Domestik, Antarabangsa & Umrah VIP berpandukan khidmat profesional. 100% Makanan Halal, penginapan strategik & sifar caj tersembunyi.
    </p>

    <!-- Search & Filter Quick Card -->
    <div class="w-full max-w-4xl bg-white/95 backdrop-blur-xl p-4 sm:p-6 rounded-2xl sm:rounded-3xl shadow-2xl border border-white/20 text-left mb-12">
      <form id="hero-search-form" class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-4 gap-4 items-end">
        
        <!-- Field 1: Category -->
        <div class="space-y-1.5">
          <label for="hero-category" class="text-xs font-bold text-slate-600 uppercase tracking-wider block">
            Jenis Percutian
          </label>
          <div class="relative">
            <select
              id="hero-category"
              name="category"
              class="w-full bg-slate-100/90 border border-slate-200 text-slate-900 text-sm rounded-xl py-3 px-3.5 focus:ring-2 focus:ring-teal-500 focus:outline-none font-medium appearance-none"
            >
              <option value="all">Semua Kategori</option>
              <option value="antarabangsa">Antarabangsa (Swiss, Jepun, dll)</option>
              <option value="umrah">Umrah & Ziarah VIP</option>
              <option value="domestik">Domestik (Sabah, dll)</option>
              <option value="pulau">Pulau & Santai (Mabul, dll)</option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-500">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </div>
          </div>
        </div>

        <!-- Field 2: Destination -->
        <div class="space-y-1.5">
          <label for="hero-destination" class="text-xs font-bold text-slate-600 uppercase tracking-wider block">
            Destinasi Impian
          </label>
          <div class="relative">
            <input
              type="text"
              id="hero-destination"
              placeholder="Contoh: Switzerland, Jepun, Makkah..."
              class="w-full bg-slate-100/90 border border-slate-200 text-slate-900 text-sm rounded-xl py-3 px-3.5 focus:ring-2 focus:ring-teal-500 focus:outline-none font-medium"
            />
          </div>
        </div>

        <!-- Field 3: Budget Range -->
        <div class="space-y-1.5">
          <label for="hero-budget" class="text-xs font-bold text-slate-600 uppercase tracking-wider block">
            Anggaran Bajet
          </label>
          <div class="relative">
            <select
              id="hero-budget"
              class="w-full bg-slate-100/90 border border-slate-200 text-slate-900 text-sm rounded-xl py-3 px-3.5 focus:ring-2 focus:ring-teal-500 focus:outline-none font-medium appearance-none"
            >
              <option value="all">Semua Bajet</option>
              <option value="1500">Bawah RM 1,500</option>
              <option value="3500">RM 1,500 - RM 3,500</option>
              <option value="7000">RM 3,500 - RM 7,000</option>
              <option value="10000">RM 7,000 ke atas</option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-500">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </div>
          </div>
        </div>

        <!-- Search Button -->
        <div>
          <button
            type="submit"
            class="w-full bg-gradient-to-r from-teal-500 to-teal-700 hover:from-teal-600 hover:to-teal-800 text-white font-bold py-3 px-4 rounded-xl shadow-lg shadow-teal-600/30 transition-all duration-200 flex items-center justify-center gap-2 group cursor-pointer"
          >
            <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span>Cari Pakej</span>
          </button>
        </div>

      </form>
    </div>

    <!-- Social Proof & Key Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 w-full max-w-4xl text-slate-200 border-t border-slate-800/80 pt-8">
      <div class="text-center">
        <div class="text-2xl sm:text-3xl font-extrabold text-white mb-1">15,000+</div>
        <div class="text-xs sm:text-sm text-slate-400 font-medium">Pelancong & Jemaah Berpuas Hati</div>
      </div>
      <div class="text-center">
        <div class="text-2xl sm:text-3xl font-extrabold text-amber-400 mb-1">4.95 / 5.0</div>
        <div class="text-xs sm:text-sm text-slate-400 font-medium">Penilaian Google & Facebook</div>
      </div>
      <div class="text-center">
        <div class="text-2xl sm:text-3xl font-extrabold text-teal-400 mb-1">100% Halal</div>
        <div class="text-xs sm:text-sm text-slate-400 font-medium">Sajian & Mesra Solat</div>
      </div>
      <div class="text-center">
        <div class="text-2xl sm:text-3xl font-extrabold text-sky-400 mb-1">Lesen Sah</div>
        <div class="text-xs sm:text-sm text-slate-400 font-medium">MOTAC & Ahli MATTA</div>
      </div>
    </div>

  </div>
</section>

<script>
  const heroForm = document.getElementById('hero-search-form');
  if (heroForm) {
    heroForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const catSelect = (document.getElementById('hero-category') as HTMLSelectElement)?.value || 'all';
      const destInput = (document.getElementById('hero-destination') as HTMLInputElement)?.value || '';

      // Scroll to packages section
      const target = document.getElementById('pakej');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
      }

      // Dispatch custom filter event for package list
      window.dispatchEvent(new CustomEvent('filter-packages', {
        detail: { category: catSelect, query: destInput }
      }));
    });
  }
</script>
