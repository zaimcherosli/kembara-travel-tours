---
import { companyInfo } from '../data/company';
---

<section class="py-16 bg-gradient-to-r from-teal-600 via-sky-600 to-teal-700 text-white relative overflow-hidden">
  
  <!-- Subtle pattern overlay -->
  <div class="absolute inset-0 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:20px_20px] opacity-15"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="max-w-3xl mx-auto space-y-6">
      <span class="inline-block bg-white/20 backdrop-blur-md text-white text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wider">
        Promosi Pakej Cuti Sekolah & Akhir Tahun
      </span>

      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        Tempah Awal Hari Ini & Nikmati Rebat Segera Sehingga RM 800 / Keluarga!
      </h2>

      <p class="text-teal-100 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto">
        Kekosongan slot penerbangan & bilik hotel 4-5 bintang adalah terhad bagi setiap tarikh perlepasan. Kunci harga promosi anda dengan deposit minimum sekarang.
      </p>

      <div class="flex flex-wrap justify-center items-center gap-4 pt-2">
        <a
          href={`https://wa.me/${companyInfo.whatsappNumber}?text=Hai%20Kembara%20Travel,%20saya%20ingin%20claim%20diskaun%20promosi%20pakej%20percutian.`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-white text-teal-800 hover:bg-slate-100 font-extrabold text-sm px-8 py-4 rounded-2xl shadow-xl transition-all hover:scale-105"
        >
          <svg class="w-5 h-5 fill-emerald-600" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Tuntut Diskaun Promosi Sekarang</span>
        </a>
        <a
          href="#pakej"
          class="inline-flex items-center gap-2 bg-teal-800/80 hover:bg-teal-900 text-white font-semibold text-sm px-6 py-4 rounded-2xl border border-white/20 transition-all"
        >
          <span>Lihat Semua Pakej</span>
        </a>
      </div>
    </div>

  </div>
</section>
